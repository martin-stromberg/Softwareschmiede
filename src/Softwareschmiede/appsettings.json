{
  "Hosting": {
    "BasePath": "/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DirectoryStructure": {
    "CacheDurationSeconds": 300,
    "MaxDepth": 2,
    "Enabled": true
  },
  "Terminal": {
    "ReplayBufferByteBudget": 524288,
    "DefaultCols": 220,
    "DefaultRows": 50,
    "AufzeichnungByteBudget": 8388608
  }
}
