{
  "Hosting": {
    "BasePath": "/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DirectoryStructure": {
    "CacheDurationSeconds": 300,
    "MaxDepth": 2,
    "Enabled": true
  },
  "AutonomAufgaben": {
    "Enabled": true,
    "DefaultTokenBudget": 500000,
    "DefaultRuntimeLimitMinutes": 480,
    "HeartbeatTimeoutSeconds": 300,
    "MaxConcurrentUnteragenten": 5,
    "SkillAutogenerationEnabled": false,
    "MaxClones": 3,
    "MaxFeatureBranches": 10
  },
  "Terminal": {
    "ReplayBufferByteBudget": 524288,
    "DefaultCols": 220,
    "DefaultRows": 50,
    "AufzeichnungByteBudget": 8388608
  }
}
