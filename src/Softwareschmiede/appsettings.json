{
  "Hosting": {
    "BasePath": "/"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DirectoryStructure": {
    "CacheDurationSeconds": 300,
    "MaxDepth": 2,
    "Enabled": true
  },
  "AutonomAufgaben": {
    "Enabled": true,
    "DefaultTokenBudget": 500000,
    "DefaultRuntimeLimitMinutes": 480,
    "HeartbeatTimeoutSeconds": 300,
    "MaxConcurrentSubagents": 5,
    "SkillAutoGenerationEnabled": false
  }
}
