<Window x:Class="Softwareschmiede.App.Views.ConsoleTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Softwareschmiede.App.Controls"
        Title="Konsolentest"
        Background="{DynamicResource BackgroundBrush}"
        Width="1200"
        Height="720"
        WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Werkzeugleiste -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8">
            <!-- WrapPanel statt StackPanel: die Leiste übersteigt die Standard-Fensterbreite —
                 ohne Umbruch würden PositionsText und "Schließen" unsichtbar abgeschnitten. -->
            <WrapPanel VerticalAlignment="Center">
                <Button Content="Aufzeichnung öffnen…"
                        AutomationProperties.Name="OpenRecording"
                        Command="{Binding OpenRecordingCommand}"
                        Padding="10,4" />
                <TextBlock Text="{Binding FilePath}"
                           AutomationProperties.Name="RecordingPath"
                           AutomationProperties.HelpText="{Binding FilePath}"
                           ToolTip="{Binding FilePath}"
                           FontSize="11"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           MaxWidth="320"
                           TextTrimming="CharacterEllipsis"
                           Margin="8,0,16,0" />
                <Button Content="Abspielen"
                        AutomationProperties.Name="StartPlayback"
                        Command="{Binding StartReplayCommand}"
                        Padding="10,4" />
                <Button Content="Neu starten"
                        AutomationProperties.Name="RestartPlayback"
                        Command="{Binding RestartPlaybackCommand}"
                        ToolTip="Wiedergabe abbrechen und sofort wieder ab Position 0 abspielen"
                        Padding="10,4"
                        Margin="8,0,0,0" />
                <Button Content="Pausieren/Fortsetzen"
                        AutomationProperties.Name="PausePlayback"
                        Command="{Binding PauseReplayCommand}"
                        Padding="10,4"
                        Margin="8,0,0,0" />
                <Button Content="Schritt zurück"
                        AutomationProperties.Name="StepBack"
                        Command="{Binding StepBackCommand}"
                        ToolTip="Zustand vor dem zuletzt angewendeten Chunk wiederherstellen"
                        Padding="10,4"
                        Margin="8,0,0,0" />
                <Button Content="Schritt vor"
                        AutomationProperties.Name="StepForward"
                        Command="{Binding StepBeforeCommand}"
                        ToolTip="Nächsten aufgezeichneten Chunk anwenden"
                        Padding="10,4"
                        Margin="8,0,0,0" />
                <TextBlock Text="Zeitraffer-Schwelle (s):"
                           FontSize="12"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,4,0" />
                <TextBox Text="{Binding TimelapseThresholdText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="TimeLapseThreshold"
                         Width="60"
                         Padding="4,2" />
                <TextBlock Text="{Binding StatusText}"
                           AutomationProperties.Name="PlaybackStatus"
                           AutomationProperties.HelpText="{Binding StatusText}"
                           FontSize="12"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="16,0,0,0" />
                <TextBlock Text="{Binding PositionText}"
                           AutomationProperties.Name="PlaybackPosition"
                           AutomationProperties.HelpText="{Binding PositionText}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
                <TextBlock Text="{Binding GeometryText}"
                           AutomationProperties.Name="RecordingGeometry"
                           AutomationProperties.HelpText="{Binding GeometryText}"
                           FontSize="12"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />
                <Button Content="Schließen"
                        AutomationProperties.Name="CloseConsoleTest"
                        Command="{Binding CloseCommand}"
                        Padding="10,4"
                        Margin="16,0,0,0"
                        HorizontalAlignment="Right" />
            </WrapPanel>
        </Border>

        <!-- Hinweis bei unvollständiger Aufzeichnung -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="8,4"
                Margin="8,8,8,0"
                Visibility="{Binding IncompleteNotice, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
            <TextBlock Text="{Binding IncompleteNotice}"
                       AutomationProperties.Name="IncompleteNotice"
                       AutomationProperties.HelpText="{Binding IncompleteNotice}"
                       Foreground="{DynamicResource SecondaryTextBrush}" />
        </Border>

        <!-- Fehlerbanner -->
        <Border Grid.Row="2"
                Background="{DynamicResource ErrorBrush}"
                CornerRadius="4"
                Padding="12,8"
                Margin="8,8,8,0"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
            <TextBlock AutomationProperties.Name="ErrorMessage"
                       AutomationProperties.HelpText="{Binding ErrorMessage}"
                       Text="{Binding ErrorMessage}"
                       Foreground="White" />
        </Border>

        <!-- Zweigeteilter Bereich: Replay-Terminal + Quell-Chunk-Liste -->
        <Grid Grid.Row="3" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ScrollViewer x:Name="ReplayTerminalScrollViewer"
                          Grid.Column="0"
                          AutomationProperties.Name="ReplayTerminalScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          CanContentScroll="True">
                <controls:TerminalControl x:Name="ReplayTerminal"
                                          AutomationProperties.Name="ReplayTerminal"
                                          Session="{Binding Session}" />
            </ScrollViewer>

            <GridSplitter Grid.Column="1"
                          HorizontalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" />

            <ListView x:Name="SourceChunkList"
                      Grid.Column="2"
                      AutomationProperties.Name="SourceChunkList"
                      ItemsSource="{Binding SourceEntries}"
                      SelectedItem="{Binding CurrentSourceEntry, Mode=TwoWay}"
                      SelectionChanged="OnSourceListSelectionChanged"
                      FontFamily="Consolas"
                      FontSize="11">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="#"
                                        DisplayMemberBinding="{Binding Index}"
                                        Width="50" />
                        <GridViewColumn Header="Offset"
                                        DisplayMemberBinding="{Binding Offset}"
                                        Width="110" />
                        <GridViewColumn Header="Bytes"
                                        DisplayMemberBinding="{Binding Length}"
                                        Width="60" />
                        <GridViewColumn Header="Quelltext"
                                        DisplayMemberBinding="{Binding Sourcetext}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>
    </Grid>
</Window>
