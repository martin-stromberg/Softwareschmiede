<Window x:Class="Softwareschmiede.App.Views.AutonomAufgabeInitialisierungsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:enums="clr-namespace:Softwareschmiede.Domain.Enums;assembly=Softwareschmiede"
        Title="Autonome Aufgabe initialisieren"
        Background="{DynamicResource SurfaceBrush}"
        Width="720"
        Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <ObjectDataProvider x:Key="PermissionsOptionValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:PermissionsJsonOption" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="24">
        <StackPanel>
            <TextBlock Text="Autonome Aufgabe initialisieren"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       Margin="0,0,0,16" />

            <Border Background="{DynamicResource ErrorBrush}"
                    Padding="10,7"
                    Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           AutomationProperties.Name="AutonomAufgabeFehler"
                           Foreground="White"
                           TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="Projektbranch" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
            <TextBox Text="{Binding SelectedProjectBranch, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="AutonomAufgabeProjektbranch"
                     Padding="8,6"
                     Margin="0,0,0,12" />

            <TextBlock Text="Initialprompt" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
            <TextBox Text="{Binding InitialPrompt, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="AutonomAufgabeInitialPrompt"
                     TextWrapping="Wrap"
                     AcceptsReturn="True"
                     Height="120"
                     VerticalScrollBarVisibility="Auto"
                     Padding="8,6"
                     Margin="0,0,0,12" />

            <TextBlock Text="Permissions-Quelle" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
            <ComboBox ItemsSource="{Binding Source={StaticResource PermissionsOptionValues}}"
                      SelectedItem="{Binding SelectedPermissionsOption, Mode=TwoWay}"
                      AutomationProperties.Name="AutonomAufgabePermissionsAuswahl"
                      Padding="6,4"
                      Margin="0,0,0,12" />

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Token-Budget" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding TokenBudget, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="AutonomAufgabeTokenBudget"
                             Padding="8,6" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Laufzeitbegrenzung (Minuten)" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
                    <TextBox Text="{Binding RuntimeLimitMinutes, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="AutonomAufgabeLaufzeitLimit"
                             Padding="8,6" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Persistenz-Modus" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,4" />
            <ComboBox IsEditable="True"
                      Text="{Binding SelectedPersistenceMode, UpdateSourceTrigger=PropertyChanged}"
                      AutomationProperties.Name="AutonomAufgabePersistenzModus"
                      Padding="6,4"
                      Margin="0,0,0,12">
                <ComboBoxItem Content="Standard" />
                <ComboBoxItem Content="SessionReset" />
            </ComboBox>

            <CheckBox Content="Token-Budget-Erweiterung durch Anwender erlauben"
                      AutomationProperties.Name="AutonomAufgabeTokenErweiterung"
                      IsChecked="{Binding AllowTokenExtension, Mode=TwoWay}"
                      Margin="0,0,0,8" />

            <CheckBox Content="Skills automatisch aus Anforderungen generieren"
                      AutomationProperties.Name="AutonomAufgabeSkillAutogenerierung"
                      IsChecked="{Binding AutoGenerateSkills, Mode=TwoWay}"
                      Margin="0,0,0,12" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="Abbrechen"
                        AutomationProperties.Name="AutonomAufgabeAbbrechen"
                        Command="{Binding AbbrechenCommand}"
                        Padding="12,6"
                        Margin="0,0,8,0" />
                <Button Content="Bestätigen"
                        AutomationProperties.Name="AutonomAufgabeBestaetigen"
                        Command="{Binding BestaetigenCommand}"
                        Padding="12,6"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
