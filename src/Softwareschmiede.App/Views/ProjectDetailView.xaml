<UserControl x:Class="Softwareschmiede.App.Views.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Softwareschmiede.App.Views"
             xmlns:controls="clr-namespace:Softwareschmiede.App.Controls"
             Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ribbon-Menü (Office-Stil) -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,8,8,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">

                <!-- Gruppe: Navigation -->
                <controls:RibbonGroup GroupName="Navigation">
                    <controls:RibbonGroup.ItemsContent>
                        <controls:RibbonLargeButton ButtonIcon="←"
                                                    ButtonText="Zurück"
                                                    AutomationName="Back"
                                                    ButtonCommand="{Binding BackCommand}" />
                    </controls:RibbonGroup.ItemsContent>
                </controls:RibbonGroup>

                <!-- Gruppe: Projekt -->
                <controls:RibbonGroup GroupName="Projekt">
                    <controls:RibbonGroup.ItemsContent>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonLargeButton ButtonIcon="💾"
                                                        ButtonText="Speichern"
                                                        AutomationName="Save"
                                                        ButtonCommand="{Binding SaveCommand}" />
                            <controls:RibbonLargeButton ButtonIcon="🗑"
                                                        ButtonText="Löschen"
                                                        AutomationName="Delete"
                                                        ButtonCommand="{Binding DeleteCommand}" />
                            <controls:RibbonLargeButton ButtonIcon="🔄" ButtonText="Aktualisieren" AutomationName="Refresh" ButtonCommand="{Binding LoadCommand}" />
                        </StackPanel>
                    </controls:RibbonGroup.ItemsContent>
                </controls:RibbonGroup>

                <!-- Gruppe: Aufgaben -->
                <controls:RibbonGroup GroupName="Aufgaben">
                    <controls:RibbonGroup.ItemsContent>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonLargeButton ButtonIcon="➕"
                                                        ButtonText="Neue Aufgabe"
                                                        AutomationName="NewWorkItem"
                                                        ButtonCommand="{Binding CreateWorkItemCommand}" />
                            <StackPanel VerticalAlignment="Center">
                                <controls:RibbonSmallButton ButtonIcon="🔽"
                                                            ButtonText="Filter"
                                                            AutomationName="Filter"
                                                            ButtonCommand="{Binding FilterCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </controls:RibbonGroup.ItemsContent>
                </controls:RibbonGroup>

                <!-- Gruppe: Repository -->
                <controls:RibbonGroup GroupName="Repository">
                    <controls:RibbonGroup.ItemsContent>
                        <StackPanel>
                            <controls:RibbonSmallButton ButtonIcon="🔗"
                                                        ButtonText="Zuweisen"
                                                        AutomationName="Assign"
                                                        ButtonCommand="{Binding AssignRepositoryCommand}" />
                            <controls:RibbonSmallButton ButtonIcon="🌐"
                                                        ButtonText="Öffnen"
                                                        AutomationName="Open"
                                                        ButtonCommand="{Binding OpenRepositoryCommand}" />
                            <controls:RibbonSmallButton ButtonIcon="📂"
                                                        ButtonText="Arbeitsverzeichnis"
                                                        AutomationName="EditWorkingDirectory"
                                                        ButtonCommand="{Binding WorkingDirectoryEditCommand}" />
                        </StackPanel>
                    </controls:RibbonGroup.ItemsContent>
                </controls:RibbonGroup>

            </StackPanel>
        </Border>

        <!-- Inhalt -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">

                <!-- Ladesymbol -->
                <TextBlock Text="Wird geladen…"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!-- Filter-Overlay -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Visibility="{Binding IsFilterOverlayVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Aufgaben filtern"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton Content="Alle"
                                         GroupName="WorkItemFilter"
                                         IsChecked="{Binding WorkItemsFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=All}"
                                         Margin="0,0,16,0" />
                            <RadioButton Content="Aktiv"
                                         GroupName="WorkItemFilter"
                                         IsChecked="{Binding WorkItemsFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Active}"
                                         Margin="0,0,16,0" />
                            <RadioButton Content="Archiviert"
                                         GroupName="WorkItemFilter"
                                         IsChecked="{Binding WorkItemsFilter, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Archived}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Projekt-Kachel (immer sichtbar, auch im Anlage-Modus) -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Symbol und Titel -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="📁"
                                       FontSize="32"
                                       Margin="0,0,12,0"
                                       VerticalAlignment="Center" />
                            <TextBox x:Name="ProjectNameTextBox"
                                     Text="{Binding ProjectName, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="ProjectName"
                                     FontSize="20"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     Background="{DynamicResource BackgroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     BorderThickness="1"
                                     Padding="8,4"
                                     MinWidth="200"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Beschreibung -->
                        <TextBox Grid.Row="1"
                                 Text="{Binding ProjectDescription, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="ProjectDescription"
                                 FontSize="14"
                                 Foreground="{DynamicResource SecondaryTextBrush}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True" />
                    </Grid>
                </Border>

                <!-- Basis-Branch-Kachel (nur wenn ein Repository zugewiesen ist) -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0 10"
                        Visibility="{Binding SelectedRepository, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Basis-Branch"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Anzeige-Modus -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsEditingSourceBranch, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="Basis-Branch:"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0" />
                            <TextBlock Text="{Binding SelectedRepositorySourceBranchName, TargetNullValue=Default, FallbackValue=Default}"
                                       AutomationProperties.AutomationId="BaseBranchDisplay"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <Button Content="Bearbeiten"
                                    AutomationProperties.Name="EditBaseBranch"
                                    Command="{Binding EditSourceBranchCommand}"
                                    Padding="10,4" />
                        </StackPanel>

                        <!-- Bearbeitungs-Modus -->
                        <StackPanel Visibility="{Binding IsEditingSourceBranch, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ComboBox ItemsSource="{Binding AvailableSourceBranchesForEdit}"
                                      SelectedItem="{Binding SelectedRepositorySourceBranchName, Mode=TwoWay}"
                                      Visibility="{Binding IsEditingSourceBranchManualInput, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                      AutomationProperties.Name="EditBaseBranchSelectionComboBox"
                                      Background="{DynamicResource BackgroundBrush}"
                                      Padding="8,6"
                                      Margin="0,0,0,8" />

                            <TextBox Text="{Binding SelectedRepositorySourceBranchName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding IsEditingSourceBranchManualInput, Converter={StaticResource BoolToVisibilityConverter}}"
                                     AutomationProperties.Name="EditBaseBranchInput"
                                     Background="{DynamicResource BackgroundBrush}"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     Padding="8,6"
                                     Margin="0,0,0,8" />

                            <TextBlock Text="{Binding SourceBranchInputError}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       Margin="0,0,0,8"
                                       TextWrapping="Wrap" />

                            <TextBlock Text="Wird geladen…"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       Visibility="{Binding IsLoadingSourceBranchesForEdit, Converter={StaticResource BoolToVisibilityConverter}}"
                                       Margin="0,0,0,8" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Speichern"
                                        AutomationProperties.Name="SaveBaseBranch"
                                        Command="{Binding SaveSourceBranchCommand}"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="10,4"
                                        Margin="0,0,8,0" />
                                <Button Content="Abbrechen"
                                        AutomationProperties.Name="CancelBaseBranch"
                                        Command="{Binding CancelSourceBranchEditCommand}"
                                        Padding="10,4" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Projektbezogene Backmerge-Freigabe (nur bei Modus „Projektbezogen aktivierbar“ und konfiguriertem Basis-Branch sichtbar) -->
                        <StackPanel Margin="0,12,0,0"
                                    Visibility="{Binding IsBackmergeOptionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <CheckBox IsChecked="{Binding IsBackmergeAutoMergeEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="BackmergeAutoMergeEnabled"
                                      Content="Backmerge-Pull-Requests automatisch mergen"
                                      Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Pull Requests vom Repository-Hauptbranch auf den konfigurierten Basis-Branch werden automatisch gemergt, sobald der Provider sie als mergebar meldet."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Initialisierungsskript-Kachel (nur wenn ein Repository zugewiesen ist) -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0 10"
                        Visibility="{Binding SelectedRepository, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Initialisierungsskript:"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Anzeige-Modus -->
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsEditingInitializationScript, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding SelectedInitializationScript, TargetNullValue='(keins)', FallbackValue='(keins)'}"
                                       AutomationProperties.AutomationId="InitializationScriptDisplay"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,12,0" />
                            <Button Content="Laden"
                                    AutomationProperties.Name="LoadInitializationScript"
                                    Command="{Binding LoadInitializationScriptSuggestionsCommand}"
                                    Padding="10,4" />
                        </StackPanel>

                        <!-- Bearbeitungs-Modus -->
                        <StackPanel Visibility="{Binding IsEditingInitializationScript, Converter={StaticResource BoolToVisibilityConverter}}">
                            <ComboBox ItemsSource="{Binding InitializationScriptSuggestionsView}"
                                      Text="{Binding SelectedInitializationScript, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      IsEditable="True"
                                      AutomationProperties.Name="InitializationScriptSelectionComboBox"
                                      Background="{DynamicResource BackgroundBrush}"
                                      Padding="8,6"
                                      Margin="0,0,0,8" />

                            <TextBlock Text="Die Initialisierungsskript-Vorschläge konnten nicht geladen werden. Der Pfad kann manuell eingegeben werden."
                                       Foreground="{DynamicResource ErrorBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       Visibility="{Binding InitializationScriptLoadingFailed, Converter={StaticResource BoolToVisibilityConverter}}" />

                            <StackPanel Orientation="Horizontal">
                                <Button Content="Speichern"
                                        AutomationProperties.Name="SaveInitializationScript"
                                        Command="{Binding SaveInitializationScriptCommand}"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="10,4"
                                        Margin="0,0,8,0" />
                                <Button Content="Abbrechen"
                                        AutomationProperties.Name="CancelInitializationScript"
                                        Command="{Binding CancelInitializationScriptEditCommand}"
                                        Padding="10,4" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Aufgaben-Kachel (nur wenn Projekt bereits persistiert ist) -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0 10"
                        Visibility="{Binding IsNeuanlage, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Titel -->
                        <TextBlock Grid.Row="0"
                                   Text="Aufgaben"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,12" />

                        <!-- Aufgabenliste -->
                        <Grid Grid.Row="1" AutomationProperties.Name="WorkItemsList">
                            <ListBox AutomationProperties.Name="OpenWorkItemsList"
                                     ItemsSource="{Binding NotFinishedWorkItems}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     MaxHeight="320">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Status}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                        <EventSetter Event="MouseDoubleClick" Handler="WorkItemDoubleClick" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Grid>

                        <Expander Grid.Row="2"
                                  Header="Beendete Aufgaben"
                                  IsExpanded="False"
                                  AutomationProperties.Name="CompletedWorkItemsExpander"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  Margin="0,12,0,0">
                            <ListBox AutomationProperties.Name="CompletedWorkItemsList"
                                     ItemsSource="{Binding FinishedWorkItems}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     MaxHeight="240"
                                     Margin="0,8,0,0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="8,4">
                                            <Grid.RowDefinitions>
                                                <RowDefinition />
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0"
                                                       Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Status}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                        <EventSetter Event="MouseDoubleClick" Handler="WorkItemDoubleClick" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Expander>
                    </Grid>
                </Border>

                <!-- Offene Anforderungen -->
                <Border Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20"
                        Margin="0 10"
                        Visibility="{Binding LoadCanRequirement, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Offene Anforderungen"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,8" />

                        <TextBlock Grid.Row="1"
                                   Text="Wird geladen…"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Visibility="{Binding IsLoadingIssues, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0,0,0,8" />

                        <ListBox Grid.Row="2"
                                 AutomationProperties.Name="OpenRequirements"
                                 ItemsSource="{Binding OpenRequirement}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 MaxHeight="300">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="8,4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition />
                                            <RowDefinition />
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                                            <TextBlock FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,0,6,0"
                                                       Text="{Binding NumberText}" />
                                            <TextBlock Text="{Binding Title}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding KindText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding DetailText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <EventSetter Event="MouseDoubleClick" Handler="IssueDoubleClick" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
