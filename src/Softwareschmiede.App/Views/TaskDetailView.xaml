<UserControl x:Class="Softwareschmiede.App.Views.TaskDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Softwareschmiede.App.Controls"
             xmlns:views="clr-namespace:Softwareschmiede.App.Views"
             x:Name="Root"
             Background="{DynamicResource BackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Ribbon-Menü -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,8,8,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          VerticalAlignment="Bottom">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">

                <!-- Gruppe: Navigation -->
                <controls:RibbonGroup GroupName="Navigation">
                    <controls:RibbonGroup.ItemsContent>
                        <controls:RibbonLargeButton ButtonIcon="←"
                                                    ButtonText="Zurück"
                                                    AutomationName="Back"
                                                    ButtonCommand="{Binding BackCommand}" />
                    </controls:RibbonGroup.ItemsContent>
                </controls:RibbonGroup>

                <!-- Gruppe: Aufgabe -->
                <controls:RibbonGroup GroupName="Aufgabe">
                    <controls:RibbonGroup.ItemsContent>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonLargeButton ButtonIcon="💾"
                                                        ButtonText="Speichern"
                                                        AutomationName="Save"
                                                        ButtonCommand="{Binding SaveCommand}" />
                            <controls:RibbonLargeButton ButtonIcon="🗑"
                                                        ButtonText="Löschen"
                                                        AutomationName="Delete"
                                                        ButtonCommand="{Binding DeleteCommand}" />
                            <controls:RibbonLargeButton ButtonIcon="▶"
                                                        ButtonText="Starten"
                                                        AutomationName="Start"
                                                        ButtonCommand="{Binding StartCommand}" />
                            <controls:RibbonLargeButton ButtonIcon="✓"
                                                        ButtonText="Beenden"
                                                        AutomationName="Exit"
                                                        ButtonCommand="{Binding CompleteWorkItemCommand}" />
                            <controls:RibbonLargeButton ButtonIcon="⏸"
                                                        ButtonText="Pause einstellen"
                                                        AutomationName="SetPause"
                                                        ButtonCommand="{Binding SetPauseCommand}"
                                                        Visibility="{Binding PauseCan, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <TextBlock Text="{Binding PauseDisplayText}"
                                       AutomationProperties.Name="PauseDisplayText"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding PauseDisplayText, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                            <TextBlock Text="{Binding TodoList.OpenTodoCount, StringFormat='⚠ {0} offen'}"
                                       AutomationProperties.Name="OpenTodoCountBadge"
                                       AutomationProperties.HelpText="{Binding TodoList.OpenTodoCount}"
                                       Foreground="{DynamicResource ErrorBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="8,0,0,0"
                                       Visibility="{Binding TodoList.OpenTodoCount, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}" />
                        </StackPanel>
                    </controls:RibbonGroup.ItemsContent>
                </controls:RibbonGroup>

                <!-- Gruppe: CLI -->
                <controls:RibbonGroup GroupName="CLI"
                                      Visibility="{Binding IsCliViewSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RibbonGroup.ItemsContent>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonLargeButton ButtonIcon="🔌"
                                                        ButtonText="Plugin ändern"
                                                        AutomationName="SwitchPlugin"
                                                        ButtonCommand="{Binding SwitchPluginCommand}"
                                                        Visibility="{Binding ShowAiPluginSelection, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <controls:RibbonLargeButton ButtonIcon="▶"
                                                        ButtonText="CLI starten"
                                                        AutomationName="RestartCli"
                                                        ButtonCommand="{Binding RestartCliCommand}"
                                                        Visibility="{Binding StartCanCliNew, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <controls:RibbonLargeButton ButtonIcon="■"
                                                        ButtonText="Stoppen"
                                                        AutomationName="StopCli"
                                                        ButtonCommand="{Binding StopCliCommand}"
                                                        Visibility="{Binding StopCanCli, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <controls:RibbonLargeButton ButtonIcon="🗎"
                                                        ButtonText="Rohausgabe exportieren"
                                                        AutomationName="CliRawExport"
                                                        ButtonCommand="{Binding ExportCliRawCommand}"
                                                        ToolTip="Protokollierte CLI-Ausgabe als Textdatei exportieren (.raw)" />
                            <controls:RibbonLargeButton ButtonIcon="⏺"
                                                        ButtonText="Aufzeichnung exportieren"
                                                        AutomationName="CliReplayExport"
                                                        ButtonCommand="{Binding ExportCliReplayCommand}"
                                                        ToolTip="CLI-Aufzeichnung für das Konsolentestfenster exportieren (.clireplay)" />
                            <StackPanel Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="Promptvorlage"
                                           FontSize="11"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,2" />
                                <ComboBox ItemsSource="{Binding PromptTemplates}"
                                          SelectedItem="{Binding SelectedPromptTemplate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="Name"
                                          AutomationProperties.Name="PromptTemplateSelection"
                                          Width="220"
                                          IsEnabled="{Binding SendCanPromptTemplate}"
                                          Padding="6,4" />
                                <StackPanel Orientation="Horizontal"
                                            Margin="0,6,0,0">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Zielzeit"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,0,0,2" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Text="{Binding ScheduledPromptTargetHours, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="ScheduledPromptHour"
                                                     Width="40"
                                                     IsEnabled="{Binding SendCanPromptTemplate}"
                                                     Padding="6,4" />
                                            <TextBlock Text=":"
                                                       VerticalAlignment="Center"
                                                       Margin="4,0"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <TextBox Text="{Binding ScheduledPromptTargetMinutes, UpdateSourceTrigger=PropertyChanged}"
                                                     AutomationProperties.Name="ScheduledPromptMinute"
                                                     Width="40"
                                                     IsEnabled="{Binding SendCanPromptTemplate}"
                                                     Padding="6,4" />
                                        </StackPanel>
                                    </StackPanel>
                                    <controls:RibbonLargeButton ButtonIcon="⏰"
                                                                ButtonText="Zeitgesteuert senden"
                                                                AutomationName="ScheduledSend"
                                                                ButtonCommand="{Binding SchedulePromptCommand}" />
                                </StackPanel>
                                <StackPanel Margin="0,4,0,0"
                                            Visibility="{Binding ScheduledPromptStatus, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                                    <TextBlock Text="{Binding ScheduledPromptStatus}"
                                               AutomationProperties.Name="ScheduledPromptStatus"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding ScheduledPromptTimeDisplay}"
                                               FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                    <Button Content="Wartestellung aufheben"
                                            AutomationProperties.Name="ReleaseWaiting"
                                            Command="{Binding CancelScheduledPromptCommand}"
                                            HorizontalAlignment="Left"
                                            Margin="0,2,0,0"
                                            Padding="6,2"
                                            FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </controls:RibbonGroup.ItemsContent>
                </controls:RibbonGroup>

                <!-- Gruppe: Dateien -->
                <controls:RibbonGroup GroupName="Dateien"
                                      Visibility="{Binding IsFileExplorerViewSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RibbonGroup.ItemsContent>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonLargeButton ButtonIcon="📁"
                                                        ButtonText="Standard"
                                                        AutomationName="DefaultFile"
                                                        ButtonCommand="{Binding FileExplorer.DefaultViewCommand}" />
                            <controls:RibbonLargeButton ButtonIcon="🔀"
                                                        ButtonText="Vergleich"
                                                        AutomationName="FileDiff"
                                                        ButtonCommand="{Binding FileExplorer.CompareCommand}" />
                            <controls:RibbonLargeButton ButtonIcon="🔄"
                                                        ButtonText="Aktualisieren"
                                                        AutomationName="RefreshFile"
                                                        ButtonCommand="{Binding FileExplorer.RefreshCommand}" />
                            <controls:RibbonLargeButton ButtonIcon="📂"
                                                        ButtonText="Datei öffnen"
                                                        AutomationName="OpenFile"
                                                        ButtonCommand="{Binding FileExplorer.OpenFileWithDefaultappCommand}" />
                        </StackPanel>
                    </controls:RibbonGroup.ItemsContent>
                </controls:RibbonGroup>

                <!-- Gruppe: Werkzeuge -->
                <controls:RibbonGroup GroupName="Werkzeuge">
                    <controls:RibbonGroup.ItemsContent>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonLargeButton ButtonIcon="🗀"
                                                        ButtonText="Arbeitsverzeichnis öffnen"
                                                        AutomationName="OpenWorkingDirectory"
                                                        ButtonCommand="{Binding OpenWorkingDirectoryCommand}" />
                            <controls:RibbonSplitButton ButtonIcon="🛠"
                                                        ButtonText="IDE öffnen"
                                                        AutomationName="OpenIde"
                                                        ButtonCommand="{Binding OpenIdeCommand}"
                                                        DropdownCommand="{Binding OpenIdeSelectionCommand}"
                                                        CanShowDropdown="{Binding SelectCanIde}" />
                        </StackPanel>
                    </controls:RibbonGroup.ItemsContent>
                </controls:RibbonGroup>

                <!-- Gruppe: Issue -->
                <controls:RibbonGroup GroupName="Issue"
                                      Visibility="{Binding ShowIssueGroup, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RibbonGroup.ItemsContent>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonLargeButton ButtonIcon="＋"
                                                        ButtonText="Issue anlegen"
                                                        AutomationName="CreateIssue"
                                                        ButtonCommand="{Binding IssueCreateCommand}"
                                                        Visibility="{Binding CanCreateIssue, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <controls:RibbonLargeButton ButtonIcon="🔗"
                                                        ButtonText="Issue zuweisen"
                                                        AutomationName="AssignIssue"
                                                        ButtonCommand="{Binding AssignIssueCommand}" />
                            <controls:RibbonLargeButton ButtonIcon="🌐"
                                                        ButtonText="Issue öffnen"
                                                        AutomationName="OpenIssue"
                                                        ButtonCommand="{Binding OpenIssueBrowserCommand}"
                                                        Visibility="{Binding CurrentIssueReference, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                        </StackPanel>
                    </controls:RibbonGroup.ItemsContent>
                </controls:RibbonGroup>

                <!-- Gruppe: Pull Request -->
                <controls:RibbonGroup GroupName="Pull Request"
                                      Visibility="{Binding ShowPullRequestPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:RibbonGroup.ItemsContent>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonLargeButton ButtonIcon="↗"
                                                        ButtonText="PR erstellen"
                                                        AutomationName="CreatePullRequest"
                                                        ButtonCommand="{Binding CreatePullRequestCommand}"
                                                        Visibility="{Binding CreateCanPullRequest, Converter={StaticResource BoolToVisibilityConverter}}" />
                            <controls:RibbonLargeButton ButtonIcon="🔄"
                                                        ButtonText="Aktualisieren"
                                                        AutomationName="RefreshPullRequests"
                                                        ButtonCommand="{Binding RefreshPullRequestsCommand}" />
                        </StackPanel>
                    </controls:RibbonGroup.ItemsContent>
                </controls:RibbonGroup>

            </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Fehler -->
        <Border Grid.Row="1"
                Background="{DynamicResource ErrorBrush}"
                Padding="12,8"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
            <TextBlock AutomationProperties.Name="ErrorMessage"
                       AutomationProperties.HelpText="{Binding ErrorMessage}"
                       Text="{Binding ErrorMessage}" Foreground="White" />
        </Border>

        <!-- Hauptinhalt -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Background="{DynamicResource SurfaceBrush}"
                        Margin="16,8">
                <TextBlock Text="Ansicht:"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           Margin="0,0,8,0" />
                <Button Content="Info"
                        AutomationProperties.Name="InfoCliToggle"
                        Command="{Binding InfoViewCommand}"
                        Padding="12,4"
                        Margin="0,0,6,0"
                        FontSize="12" />
                <Button Content="CLI"
                        AutomationProperties.Name="CliViewButton"
                        Command="{Binding CliViewCommand}"
                        Padding="12,4"
                        Margin="0,0,6,0"
                        FontSize="12"
                        Visibility="{Binding ShowCliPanel, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Diff"
                        AutomationProperties.Name="DiffViewButton"
                        Command="{Binding DiffViewCommand}"
                        Padding="12,4"
                        Margin="0,0,6,0"
                        FontSize="12"
                        Visibility="{Binding ShowDiffPanel, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Dateien"
                        AutomationProperties.Name="FileViewButton"
                        Command="{Binding FileViewCommand}"
                        Padding="12,4"
                        FontSize="12"
                        Visibility="{Binding ShowFileExplorerPanel, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="PR"
                        AutomationProperties.Name="PullRequestViewButton"
                        Command="{Binding PullRequestViewCommand}"
                        Padding="12,4"
                        Margin="6,0,0,0"
                        FontSize="12"
                        Visibility="{Binding ShowPullRequestPanel, Converter={StaticResource BoolToVisibilityConverter}}" />
                <Button Content="Todos"
                        AutomationProperties.Name="TodoViewButton"
                        Command="{Binding TodoList.TodoViewCommand}"
                        Padding="12,4"
                        Margin="6,0,0,0"
                        FontSize="12" />
            </StackPanel>

            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsInfoViewSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="24">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,12"
                                Visibility="{Binding ShowEditPanel, Converter={StaticResource BoolToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="Aufgabe bearbeiten"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,16" />

                                <TextBlock Text="Titel"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditTitle, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="EditTitle"
                                         FontSize="14"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         Background="{DynamicResource BackgroundBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1"
                                         Padding="8,6"
                                         Margin="0,0,0,16" />

                                <TextBlock Text="Anforderungsbeschreibung"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding EditRequirementDescription, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="EditRequirementDescription"
                                         FontSize="14"
                                         Foreground="{DynamicResource PrimaryTextBrush}"
                                         Background="{DynamicResource BackgroundBrush}"
                                         BorderBrush="{DynamicResource BorderBrush}"
                                         BorderThickness="1"
                                         Padding="8,6"
                                         MinHeight="120"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16"
                                Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{Binding WorkItemTitle}"
                                           AutomationProperties.Name="WorkItemTitle"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="{Binding WorkItemStatus}"
                                           FontSize="12"
                                           Foreground="{DynamicResource AccentBrush}"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="{Binding WorkItem.RequirementDescription}"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Protokoll"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,8" />
                                <ListBox ItemsSource="{Binding LogEntries}"
                                         AutomationProperties.Name="TaskProtocol"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         MaxHeight="400">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="4,2" MaxWidth="800">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Type}"
                                                           AutomationProperties.Name="{Binding Type, StringFormat={}ProtokollTyp-{0}}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Top" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Content}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer x:Name="TerminalScrollViewer"
                              AutomationProperties.Name="TerminalScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              CanContentScroll="True"
                              PreviewMouseDown="OnTerminalScrollViewerPreviewMouseDown"
                              Visibility="{Binding IsCliViewSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <controls:TerminalControl x:Name="TerminalConsole"
                                              AutomationProperties.Name="TerminalConsole" />
                </ScrollViewer>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsDiffViewSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="24">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <TextBlock Text="Diff-Ansicht wird hier angezeigt... (Implementierung folgt später)"
                                       FontSize="14"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <views:FileExplorerView DataContext="{Binding FileExplorer}"
                                        Visibility="{Binding DataContext.IsFileExplorerViewSelected, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsPullRequestViewSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Margin="24">
                        <Border Background="{DynamicResource SurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="16">
                            <StackPanel>
                                <TextBlock Text="Keine Pull Requests vorhanden"
                                           AutomationProperties.Name="PullRequestsEmpty"
                                           FontSize="13"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           FontStyle="Italic"
                                           HorizontalAlignment="Center"
                                           Margin="0,8"
                                           Visibility="{Binding HasNoPullRequests, Converter={StaticResource BoolToVisibilityConverter}}" />
                                <ItemsControl ItemsSource="{Binding PullRequests}"
                                              AutomationProperties.Name="PullRequestsList"
                                              Visibility="{Binding HasPullRequests, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="0,0,0,1"
                                                    Padding="0,0,0,12"
                                                    Margin="0,0,0,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="15"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               TextWrapping="Wrap" />
                                                    <Button Command="{Binding DataContext.OpenPullRequestUrlCommand, ElementName=Root}"
                                                            CommandParameter="{Binding Url}"
                                                            AutomationProperties.Name="OpenPullRequestUrl"
                                                            HorizontalAlignment="Left"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            Margin="0,2,0,8"
                                                            Cursor="Hand">
                                                        <TextBlock Text="{Binding Url}"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   TextDecorations="Underline"
                                                                   TextWrapping="Wrap" />
                                                    </Button>
                                                    <UniformGrid Columns="4" Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding PullRequestNumber, StringFormat='PR #{0}'}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding ProviderText}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding RoleText}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding Status, StringFormat='Status: {0}'}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="12" />
                                                    </UniformGrid>
                                                    <UniformGrid Columns="3" Margin="0,0,0,8">
                                                        <TextBlock Text="{Binding MergeStatus, StringFormat='Merge: {0}'}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding MonitoringPhaseText, StringFormat='Phase: {0}'}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="12" />
                                                        <TextBlock Text="{Binding SourceBranch, StringFormat='Branch: {0}'}"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                                   FontSize="12" />
                                                    </UniformGrid>
                                                    <TextBlock Text="{Binding LastError}"
                                                               Foreground="{DynamicResource ErrorBrush}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Margin="0,0,0,8"
                                                               Visibility="{Binding LastError, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                                                    <ItemsControl ItemsSource="{Binding WorkflowRuns}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,3">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="2*" />
                                                                        <ColumnDefinition Width="120" />
                                                                        <ColumnDefinition Width="120" />
                                                                        <ColumnDefinition Width="90" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Name}"
                                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                                               FontSize="12"
                                                                               TextWrapping="Wrap" />
                                                                    <TextBlock Grid.Column="1"
                                                                               Text="{Binding Status}"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                                               FontSize="12" />
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding Conclusion}"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                                               FontSize="12" />
                                                                    <TextBlock Grid.Column="3"
                                                                               Text="{Binding IsPostMerge, StringFormat='Post: {0}'}"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                                               FontSize="12" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <views:TodoListView DataContext="{Binding TodoList}"
                                    Visibility="{Binding DataContext.IsTodoViewSelected, ElementName=Root, Converter={StaticResource BoolToVisibilityConverter}}" />
            </Grid>
        </Grid>

        <!-- Statusleiste -->
        <Border Grid.Row="3"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <controls:StatusIndicatorControl Grid.Column="0"
                                                 Status="{Binding WorkItemStatus, Mode=OneWay}"
                                                 BranchName="{Binding WorkItemBranchName, Mode=OneWay}" />
                <TextBlock Grid.Column="1"
                           Text="{Binding CliStatusText}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           AutomationProperties.AutomationId="CliStatusText" />
                <TextBlock Grid.Column="2"
                           Text="{Binding ActiveCliName, StringFormat='CLI: {0}'}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           VerticalAlignment="Center"
                           AutomationProperties.AutomationId="ActiveCliName"
                           Visibility="{Binding ActiveCliName, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                
            </Grid>            
        </Border>
    </Grid>
</UserControl>
