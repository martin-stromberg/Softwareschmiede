<UserControl x:Class="Softwareschmiede.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Softwareschmiede.App.Controls"
             xmlns:local="clr-namespace:Softwareschmiede.App.Views"
             Background="{DynamicResource BackgroundBrush}">
    <UserControl.Resources>
        <local:PluginSettingFieldTemplateSelector x:Key="FieldTemplateSelector">
            <local:PluginSettingFieldTemplateSelector.TextTemplate>
                <DataTemplate>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding Field.Key}"
                             Width="320"
                             HorizontalAlignment="Left" />
                </DataTemplate>
            </local:PluginSettingFieldTemplateSelector.TextTemplate>
            <local:PluginSettingFieldTemplateSelector.SecretTemplate>
                <DataTemplate>
                    <PasswordBox Tag="{Binding}"
                                 AutomationProperties.Name="{Binding Field.Key}"
                                 Width="320"
                                 HorizontalAlignment="Left"
                                 Loaded="OnPasswordBoxLoaded"
                                 PasswordChanged="OnPasswordChanged" />
                </DataTemplate>
            </local:PluginSettingFieldTemplateSelector.SecretTemplate>
            <local:PluginSettingFieldTemplateSelector.UrlTemplate>
                <DataTemplate>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             Width="320"
                             HorizontalAlignment="Left" />
                </DataTemplate>
            </local:PluginSettingFieldTemplateSelector.UrlTemplate>
            <local:PluginSettingFieldTemplateSelector.IntegerTemplate>
                <DataTemplate>
                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="{Binding Field.Key}"
                             Width="120"
                             HorizontalAlignment="Left" />
                </DataTemplate>
            </local:PluginSettingFieldTemplateSelector.IntegerTemplate>
            <local:PluginSettingFieldTemplateSelector.BooleanTemplate>
                <DataTemplate>
                    <CheckBox IsChecked="{Binding BoolValue, UpdateSourceTrigger=PropertyChanged}"
                              Content="{Binding Field.Label}" />
                </DataTemplate>
            </local:PluginSettingFieldTemplateSelector.BooleanTemplate>
            <local:PluginSettingFieldTemplateSelector.EnumTemplate>
                <DataTemplate>
                    <ComboBox SelectedValue="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{Binding Field.Key}"
                              ItemsSource="{Binding Field.EnumOptions}"
                              Width="220"
                              HorizontalAlignment="Left" />
                </DataTemplate>
            </local:PluginSettingFieldTemplateSelector.EnumTemplate>
            <local:PluginSettingFieldTemplateSelector.FilePathTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 Width="280"
                                 VerticalAlignment="Center" />
                        <Button Content="…"
                                Width="28"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Click="OnFileSelectClick" />
                    </StackPanel>
                </DataTemplate>
            </local:PluginSettingFieldTemplateSelector.FilePathTemplate>
            <local:PluginSettingFieldTemplateSelector.CommandLineParametersTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="CommandLineParameters"
                                 Width="280"
                                 VerticalAlignment="Center" />
                        <Button Content="?"
                                AutomationProperties.Name="CliHelpButton"
                                Width="28"
                                Margin="4,0,0,0"
                                VerticalAlignment="Center"
                                Click="OnHelpButtonClick" />
                    </StackPanel>
                </DataTemplate>
            </local:PluginSettingFieldTemplateSelector.CommandLineParametersTemplate>
        </local:PluginSettingFieldTemplateSelector>

        <Style x:Key="PluginActivationListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gemeinsames ItemTemplate für die Einstellungsgruppen eines ausgewählten Plugins (SCM/KI- und IDE-Register). -->
        <DataTemplate x:Key="PluginSettingGroupsItemTemplate">
            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding GroupName}"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           Margin="0,10,0,5" />
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,4">
                                <TextBlock Text="{Binding Field.Label}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,2" />
                                <ContentControl Content="{Binding}"
                                                ContentTemplateSelector="{StaticResource FieldTemplateSelector}" />
                                <TextBlock Text="{Binding Field.Description}"
                                           FontSize="11"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Visibility="{Binding Field.Description, Converter={StaticResource NullOrEmptyToVisibilityConverter}}"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Ribbon-Menü (Office-Stil) -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,8,8,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">

                <!-- Gruppe: Settings -->
                <controls:RibbonGroup GroupName="Projekt">
                    <controls:RibbonGroup.ItemsContent>
                        <StackPanel Orientation="Horizontal">
                            <controls:RibbonLargeButton ButtonIcon="💾"
                                                ButtonText="Speichern"
                                                AutomationName="Save"
                                                ButtonCommand="{Binding SaveCommand}" />
                            <controls:RibbonLargeButton ButtonIcon="↺"
                                                ButtonText="Verwerfen"
                                                AutomationName="Discard"
                                                ButtonCommand="{Binding DiscardCommand}" />
                        </StackPanel>
                    </controls:RibbonGroup.ItemsContent>
                </controls:RibbonGroup>

            </StackPanel>
        </Border>

        <!-- Meldungen -->
        <StackPanel Grid.Row="1" Margin="8,0,8,0">
            <Border Background="{DynamicResource SuccessBrush}"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,8,0,8"
                    Visibility="{Binding SuccessMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                <TextBlock Text="{Binding SuccessMessage}" Foreground="White" />
            </Border>
            <Border Background="{DynamicResource ErrorBrush}"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,8,0,8"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
                <TextBlock AutomationProperties.Name="ErrorMessage"
                           AutomationProperties.HelpText="{Binding ErrorMessage}"
                           Text="{Binding ErrorMessage}" Foreground="White" />
            </Border>
        </StackPanel>

        <!-- Registerkarten -->
        <TabControl Grid.Row="2" Margin="08,8,8,8" HorizontalAlignment="Stretch"
                    Background="{DynamicResource SurfaceBrush}"
                    Foreground="{DynamicResource PrimaryTextBrush}">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border"
                                        BorderThickness="1,1,1,0"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        CornerRadius="4,4,0,0" Margin="2,0">
                                    <ContentPresenter x:Name="ContentSite"
                                        VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        ContentSource="Header"
                                        Margin="10,2"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource SelectedTabBackgroundBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource UnselectedTabBackgroundBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <TabItem>
                <TabItem.Header >
                    <StackPanel Orientation="Horizontal" Margin="0">
                        <Ellipse Width="10" Height="10" Fill="DarkGray" Margin="0,0,8,0"/>
                        <TextBlock Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">Allgemein</TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16">
                    <!-- Designmodus -->
                    <StackPanel Margin="0,0,0,16" MaxWidth="600" HorizontalAlignment="Left">
                        <Label Content="Design"
                           FontWeight="SemiBold"
                           Margin="0,0,0,4" />
                        <ComboBox SelectedValue="{Binding DesignMode, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="DesignMode"
                                  ItemsSource="{Binding DesignModes}"
                                  Margin="0,0,0,12"
                                  Padding="8,6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Arbeitsverzeichnis -->
                    <StackPanel Margin="0,0,0,16" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Arbeitsverzeichnis"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Verzeichnis, in dem Repository-Klone gespeichert werden."
                                   FontSize="12"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,8" />
                        <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="8,6"
                                 BorderBrush="{DynamicResource BorderBrush}" />
                    </StackPanel>

                    <!-- Updates -->
                    <StackPanel Margin="0,0,0,16" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Updates"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Legt fest, ob und wie nach Programmupdates gesucht wird. Bei „Nur prüfen“ wird ein gefundenes Update nur angezeigt, nicht installiert."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <ComboBox SelectedItem="{Binding SelectedUpdateMode, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="Update-Mode"
                                  ItemsSource="{Binding UpdateModeOptions}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,12"
                                  Padding="8,6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Text="Update-Pfad"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,4" />
                        <ComboBox SelectedItem="{Binding SelectedUpdatePath, UpdateSourceTrigger=PropertyChanged}"
                                  AutomationProperties.Name="Update-Path"
                                  ItemsSource="{Binding UpdatePathOptions}"
                                  HorizontalAlignment="Stretch"
                                  Margin="0,0,0,8"
                                  Padding="8,6">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Kanal: "
                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="{Binding DerivedUpdateChannel}"
                                       AutomationProperties.AutomationId="UpdateChannel"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                        </StackPanel>
                        <TextBlock Text="Der Update-Pfad legt ausschließlich den UpdateChannel fest: „StableVersions“ berücksichtigt nur stabile Versionen, „Vorabversionen“ nur Release-Kandidaten — niemals gemischt. Vorabversionen können noch Fehler enthalten."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Diagnose -->
                    <StackPanel Margin="0,0,0,16" MaxWidth="600" HorizontalAlignment="Left">
                        <TextBlock Text="Diagnose"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,4" />
                        <TextBlock Text="Öffnet das Konsolentestfenster, mit dem eine exportierte CLI-Aufzeichnung (.clireplay) zeitgesteuert durch den echten Terminal-Renderpfad abgespielt werden kann."
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8" />
                        <Button Content="Konsolentestfenster öffnen"
                                AutomationProperties.Name="OpenConsoleTest"
                                Command="{Binding OpenConsoleTestCommand}"
                                Padding="12,6"
                                HorizontalAlignment="Left" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header >
                    <StackPanel Orientation="Horizontal" Margin="0">
                        <TextBlock Margin="0,0,8,0" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.88" >⚙</TextBlock>
                        <TextBlock Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">Automatisierung</TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16" MaxWidth="640" HorizontalAlignment="Left">
                    <!-- Aufgaben ausführen -->
                    <Expander AutomationProperties.Name="WorkItemsExecuteExpander"
                              IsExpanded="False"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Margin="0,0,0,16">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Aufgaben ausführen"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="{Binding WorkItemsExecuteStatusText}"
                                           AutomationProperties.Name="WorkItemsExecuteStatus"
                                           AutomationProperties.HelpText="{Binding WorkItemsExecuteStatusText}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <CheckBox IsChecked="{Binding IsScmMonitoringEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="IsScmMonitoringEnabled"
                                      Content="Aufgaben automatisch starten"
                                      Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Bei deaktivierter Funktion werden keine SCM-Sources abgefragt und keine Aufgaben automatisch gestartet. Bereits eingegangene Ereignisse bleiben erhalten und können weiterhin manuell geöffnet, geprüft oder abgebrochen werden. Die Änderung wirkt ohne Neustart."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0" />
                            <TextBlock Text="Überwachungsmodus"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,12,0,4" />
                            <ComboBox SelectedItem="{Binding SelectedAccountMode, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="MonitoringMode"
                                      ItemsSource="{Binding AccountModeOptions}"
                                      IsEnabled="{Binding IsMonitoringModeEnabled}"
                                      HorizontalAlignment="Stretch"
                                      Padding="8,6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="„Benutzerkonto“ überwacht die registrierten Projekt-Repositories direkt und reagiert auf das Trigger-Keyword. „Separates Konto“ überwacht stattdessen die GitHub-Benachrichtigungen eines separaten Kontos und reagiert auf Erwähnungen (@Kontoname); dafür ist unter Plugins → GitHub → Authentifizierung ein eigener Token mit den Scopes notifications und repo erforderlich."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <StackPanel AutomationProperties.Name="TriggerKeywordArea"
                                        Visibility="{Binding IsTriggerKeywordVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Trigger-Keyword"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,12,0,4" />
                                <TextBox Text="{Binding ScmTriggerKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="ScmTriggerKeyword"
                                         Padding="8,6"
                                         BorderBrush="{DynamicResource BorderBrush}" />
                                <TextBlock Text="Schlüsselwort, mit dem SCM-Ereignisse in Issues und Pull Requests markiert werden. Nur frei stehende Vorkommen ohne direkt angrenzende Zitatzeichen lösen aus; die Groß-/Kleinschreibung wird nicht beachtet. Leer lassen ist nicht zulässig; Standard: $Softwareschmiede."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel AutomationProperties.Name="DelayKeywordArea"
                                        Visibility="{Binding IsDelayKeywordVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Verzögerungs-Keyword"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,12,0,4" />
                                <TextBox Text="{Binding ScmDelayKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="ScmDelayKeyword"
                                         Padding="8,6"
                                         BorderBrush="{DynamicResource BorderBrush}" />
                                <TextBlock Text="Schlüsselwort, mit dem ein SCM-Ereignis eine verzögerte Ausführung anfordert — im selben Text wie der Trigger, gefolgt von der Angabe: 30min, 4h, 2t/2d, 1w oder m&lt;Tag&gt; für den Kalendertag im Monat (z. B. m1). Maximal 32 Tage; der Wartezustand übersteht Neustart und blockiert den Auto-Shutdown. Leer lassen ist nicht zulässig; Standard: #verzögert."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel AutomationProperties.Name="MaxParallelExecutionsArea">
                                <TextBlock Text="Maximale parallele Ausführungen"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,12,0,4" />
                                <TextBox Text="{Binding MaxParallelExecutions, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="MaxParallelExecutions"
                                         Padding="8,6"
                                         BorderBrush="{DynamicResource BorderBrush}" />
                                <TextBlock Text="Globales Limit gleichzeitig laufender KI-CLI-Ausführungen aus SCM-Ereignissen. Ganzzahl ≥ 1; leer = unbegrenzt. Bei Erreichen des Limits warten weitere Ereignisse mit Wartegrund, bis ein Platz frei wird; die Reihenfolge folgt der Priorisierung (Fortsetzungen vor fälligen Verzögerungen vor Eingangsreihenfolge). Pro KI-Plugin lässt sich zusätzlich ein eigenes Limit unter „Plugins“ festlegen."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel AutomationProperties.Name="PromptAttachmentsArea"
                                        Visibility="{Binding IsPromptAppendVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Prompt-Anhänge"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,16,0,4" />
                                <TextBlock Text="Texte, die bei der Zustellung automatisch an das SCM-Ereignis angehängt werden — z. B. Hinweise auf verfügbare Skills oder Bearbeitungsregeln, ohne sie in jedem Kommentar zu nennen. Der allgemeine Anhang wird zuerst eingefügt, danach der zur Ereignisart passende. Ein leeres Feld hängt nichts an. Die Anhänge verändern weder den gespeicherten Ereignistext noch die Trigger-Prüfung."
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,8" />
                                <TextBlock Text="Allgemein (alle Ereignisarten)"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,4" />
                                <TextBox Text="{Binding ScmPromptAppendixGeneral, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="ScmPromptAppendixGeneral"
                                         AcceptsReturn="True"
                                         MinHeight="48"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="8,6"
                                         BorderBrush="{DynamicResource BorderBrush}" />
                                <TextBlock Text="Issue"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,8,0,4" />
                                <TextBox Text="{Binding ScmPromptAppendixIssue, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="ScmPromptAppendixIssue"
                                         AcceptsReturn="True"
                                         MinHeight="48"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="8,6"
                                         BorderBrush="{DynamicResource BorderBrush}" />
                                <TextBlock Text="Issue-Kommentar"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,8,0,4" />
                                <TextBox Text="{Binding ScmPromptAppendixIssueComment, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="ScmPromptAppendixIssueComment"
                                         AcceptsReturn="True"
                                         MinHeight="48"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="8,6"
                                         BorderBrush="{DynamicResource BorderBrush}" />
                                <TextBlock Text="Pull Request"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,8,0,4" />
                                <TextBox Text="{Binding ScmPromptAppendixPullRequest, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="ScmPromptAppendixPullRequest"
                                         AcceptsReturn="True"
                                         MinHeight="48"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="8,6"
                                         BorderBrush="{DynamicResource BorderBrush}" />
                                <TextBlock Text="Pull-Request-Kommentar (inkl. Reviews)"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,8,0,4" />
                                <TextBox Text="{Binding ScmPromptAppendixPullRequestComment, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="ScmPromptAppendixPullRequestComment"
                                         AcceptsReturn="True"
                                         MinHeight="48"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         Padding="8,6"
                                         BorderBrush="{DynamicResource BorderBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <!-- Issue-Aufbereitung -->
                    <Expander AutomationProperties.Name="IssuePreparationExpander"
                              IsExpanded="False"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Margin="0,0,0,16">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Issue-Aufbereitung"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="{Binding IssuePreparationStatusText}"
                                           AutomationProperties.Name="IssuePreparationStatus"
                                           AutomationProperties.HelpText="{Binding IssuePreparationStatusText}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <CheckBox IsChecked="{Binding IsIssuePreparationEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="IssuePreparationEnabledCheckBox"
                                      Content="Neu angelegte Issues automatisch analysieren und verbessern"
                                      Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Wenn aktiviert, werden neu angelegte Issues der ausgewählten Repositories automatisch von einer KI-CLI analysiert: Die Beschreibung wird auf Verständlichkeit, Vollständigkeit, offene Fragen, Risiken und Zielkonflikte geprüft und remote durch eine optimierte Fassung ersetzt (der Titel bleibt unverändert). Die Ausführung zählt in die Ausführungsbegrenzung aus „Aufgaben ausführen“. Die Änderung wirkt ohne Neustart."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0" />
                            <TextBlock Text="KI-Plugin für die Aufbereitung"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,12,0,4" />
                            <ComboBox SelectedItem="{Binding SelectedIssuePreparationAiPlugin, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="IssuePreparationPluginComboBox"
                                      ItemsSource="{Binding IssuePreparationAiPluginOptions}"
                                      IsEnabled="{Binding IsIssuePreparationFieldEnabled}"
                                      HorizontalAlignment="Stretch"
                                      Padding="8,6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Welche CLI die Analyse ausführt. „Globale Standard-CLI verwenden“ nutzt dieselbe Auflösungskette wie SCM-Ereignisse (Projekt-Standard → globaler Standard). Ist das gewählte Plugin nicht installiert oder deaktiviert, wartet der Auftrag mit ehrlichem Grund."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <TextBlock Text="Überwachte Repositories"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,12,0,4" />
                            <ItemsControl ItemsSource="{Binding IssuePreparationRepositories}"
                                          AutomationProperties.Name="IssuePreparationRepositoriesList"
                                          IsEnabled="{Binding IsIssuePreparationFieldEnabled}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  AutomationProperties.Name="{Binding RepositoryName}"
                                                  Content="{Binding RepositoryName}"
                                                  Foreground="{DynamicResource PrimaryTextBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Nur in den hier markierten Repositories lösen neu angelegte Issues eine Aufbereitung aus. Die Auswahl wirkt erst gemeinsam mit dem Funktionsschalter oben — und vorausgesetzt, das Repository wird von der Ereignisüberwachung erfasst (registriertes Projekt-Repository)."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <CheckBox IsChecked="{Binding IsIssuePreparationCommentEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="IssuePreparationCommentCheckBox"
                                      Content="Analyseergebnisse als Issue-Kommentar dokumentieren"
                                      IsEnabled="{Binding IsIssuePreparationFieldEnabled}"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      Margin="0,12,0,0" />
                            <TextBlock Text="Zusätzlich zur ersetzten Beschreibung wird ein Kommentar mit Schwachstellen, offenen Fragen, Lösungsansätzen, Risiken, Zielkonflikten und Verbesserungsvorschlägen angelegt. Fehler werden dagegen nie als Kommentar am Issue gemeldet."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0" />
                        </StackPanel>
                    </Expander>

                    <!-- Aufgaben beenden -->
                    <Expander AutomationProperties.Name="WorkItemsExitExpander"
                              IsExpanded="False"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Margin="0,0,0,16">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Aufgaben beenden"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="{Binding WorkItemsExitStatusText}"
                                           AutomationProperties.Name="WorkItemsExitStatus"
                                           AutomationProperties.HelpText="{Binding WorkItemsExitStatusText}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <CheckBox IsChecked="{Binding IsScmTaskCompletionEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="IsScmTaskCompletionEnabled"
                                      Content="Aufgaben automatisch beenden"
                                      Foreground="{DynamicResource PrimaryTextBrush}" />
                            <TextBlock Text="Beobachtet zyklisch die verknüpften Pull Requests bzw. Issues der durch den Prüfmodus bestimmten Aufgaben. Beobachtet werden ausschließlich Aufgaben mit SCM-Referenz (Issue oder Pull Request). Ist die Referenz geschlossen oder gemergt, wird die Aufgabe nach der eingestellten Wartezeit automatisch beendet — inklusive einer noch laufenden KI-Ausführung. Die Änderung wirkt ohne Neustart."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0" />
                            <TextBlock Text="Prüfmodus"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="22,8,0,4" />
                            <ComboBox SelectedItem="{Binding SelectedScmTaskCompletionCheckmode, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="CheckMode"
                                      ItemsSource="{Binding ScmTaskCompletionCheckmodeOptions}"
                                      IsEnabled="{Binding IsTaskCompletionFieldEnabled}"
                                      HorizontalAlignment="Stretch"
                                      Margin="22,0,0,0"
                                      Padding="8,6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="„Nur ereignisgesteuerte Aufgaben“ beobachtet ausschließlich Aufgaben mit SCM-Ereigniszuordnung. „Alle Aufgaben“ beobachtet zusätzlich manuell angelegte Aufgaben — weiterhin nur solche mit Issue- oder Pull-Request-Verknüpfung."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0" />
                            <TextBlock Text="Wartezeit für Beendigung"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="22,8,0,4" />
                            <TextBox Text="{Binding ScmTaskCompletionWaitMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.Name="ScmTaskCompletionWaitMinutes"
                                     IsEnabled="{Binding IsTaskCompletionFieldEnabled}"
                                     Width="120"
                                     HorizontalAlignment="Left"
                                     Margin="22,0,0,0"
                                     Padding="8,6"
                                     BorderBrush="{DynamicResource BorderBrush}" />
                            <TextBlock Text="Zeit zwischen dem erkannten Schließen bzw. Mergen der verknüpften Referenz und dem automatischen Beenden der Aufgabe. Ganzzahl in Minuten; Standard: 60."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0" />
                        </StackPanel>
                    </Expander>

                    <!-- Prozessabläufe -->
                    <Expander AutomationProperties.Name="ProcessRunsExpander"
                              IsExpanded="False"
                              Foreground="{DynamicResource PrimaryTextBrush}"
                              Margin="0,0,0,16">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Prozessabläufe"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                <TextBlock Text="{Binding ProcessRunsStatusText}"
                                           AutomationProperties.Name="ProcessRunsStatus"
                                           AutomationProperties.HelpText="{Binding ProcessRunsStatusText}"
                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="8,0,0,0" />
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="Backmerge-Pull-Requests"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,4" />
                            <ComboBox SelectedItem="{Binding SelectedBackmergeMode, UpdateSourceTrigger=PropertyChanged}"
                                      AutomationProperties.Name="Backmerge-Modus"
                                      ItemsSource="{Binding BackmergeModeOptions}"
                                      HorizontalAlignment="Stretch"
                                      Padding="8,6">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Ein Backmerge-Pull-Request (head = Hauptbranch des Repositories, base = konfigurierter Basis-Branch eines Projekts) aktualisiert nur den Arbeitsbranch. Bei „Global aktiviert“ wird er in allen Projekten automatisch gemergt, sobald der Provider ihn als mergebar meldet; bei „Projektbezogen aktivierbar“ zusätzlich nur in Projekten, in denen die Option in der Projektdetailansicht eingeschaltet ist. Voraussetzung ist ein eingerichteter, vom Hauptbranch abweichender Basis-Branch sowie ein Token mit Schreibrecht. Die Prüfung läuft in einem eigenen Zyklus unabhängig von den übrigen Automatisierungsfunktionen und immer unter dem Benutzerkonto."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0" />
                            <CheckBox IsChecked="{Binding IsScmBackmergeDraftActivation, Mode=TwoWay}"
                                      AutomationProperties.Name="IsScmBackmergeDraftActivation"
                                      IsEnabled="{Binding IsProcessRunsFieldEnabled}"
                                      Content="Draft-Pull-Requests vor dem Merge automatisch aktivieren"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      Margin="0,12,0,0" />
                            <TextBlock Text="Ist ein erkannter Backmerge-Pull-Request noch als Entwurf markiert, wird er mit dieser Option vor dem Merge automatisch als bereit für Review markiert. Ohne die Option wartet der Merge, bis der Entwurf manuell aufgehoben wurde."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0" />
                            <CheckBox IsChecked="{Binding IsScmBackmergeAdminMerge, Mode=TwoWay}"
                                      AutomationProperties.Name="IsScmBackmergeAdminMerge"
                                      IsEnabled="{Binding IsProcessRunsFieldEnabled}"
                                      Content="Bei blockiertem Merge Admin-Merge erlauben"
                                      Foreground="{DynamicResource PrimaryTextBrush}"
                                      Margin="0,12,0,0" />
                            <TextBlock Text="Der Merge läuft zuerst regulär. Schlägt er am Branch-Schutz fehl (z. B. fehlende Statuschecks oder Reviews), wird er mit dieser Option einmalig als Admin-Merge wiederholt, der den Branch-Schutz umgeht. Voraussetzung ist ein Token mit Admin-Recht."
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="22,4,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem>
                <TabItem.Header >
                    <StackPanel Orientation="Horizontal" Margin="0">
                        <TextBlock Margin="0,0,8,0" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.88" >🔌</TextBlock>
                        <TextBlock Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">Plugins</TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Linke Spalte: Standard-Plugin-Auswahl und Aktivierungslisten -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <!-- Standard SCM-Plugin -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Standard SCM-Plugin"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox SelectedValue="{Binding DefaultScmPlugin, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding ScmPlugins}"
                                          Margin="0,0,0,12"
                                          Padding="8,6"
                                          SelectionChanged="OnPluginSelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PluginName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>

                                <!-- Standard KI-Plugin -->
                                <TextBlock Text="Standard KI-Plugin"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           Margin="0,0,0,4" />
                                <ComboBox SelectedValue="{Binding DefaultAiPlugin, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="PluginName"
                                          AutomationProperties.Name="DefaultAiPlugin"
                                          ItemsSource="{Binding AiPlugins}"
                                          Padding="8,6"
                                          SelectionChanged="OnPluginSelectionChanged">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding PluginName}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>

                            <!-- Aktivierung SCM-Plugins -->
                            <TextBlock Text="Quellcodeverwaltung"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,8,0,4" />
                            <ListBox ItemsSource="{Binding SourceCodeManagementPlugins}"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     Margin="0,0,0,16"
                                     ItemContainerStyle="{StaticResource PluginActivationListBoxItemStyle}"
                                     SelectionChanged="OnPluginSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PluginName}"
                                                       AutomationProperties.Name="{Binding PluginPrefix, StringFormat={}{0}.Entry}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Aktivierung KI-Plugins -->
                            <TextBlock Text="KI"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding DevelopmentAutomationPlugins}"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     Margin="0,0,0,16"
                                     ItemContainerStyle="{StaticResource PluginActivationListBoxItemStyle}"
                                     SelectionChanged="OnPluginSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding PluginName}"
                                                       AutomationProperties.Name="{Binding PluginPrefix, StringFormat={}{0}.Entry}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Aktivierung und Reihenfolge IDE-Plugins -->
                            <TextBlock Text="Integrierte Entwicklungsumgebungen (IDE)"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       Margin="0,0,0,4" />
                            <ListBox ItemsSource="{Binding DevelopmentEnvironmentPlugins}"
                                     AutomationProperties.Name="IdePluginList"
                                     Background="{DynamicResource SurfaceBrush}"
                                     Foreground="{DynamicResource PrimaryTextBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     HorizontalContentAlignment="Stretch"
                                     ItemContainerStyle="{StaticResource PluginActivationListBoxItemStyle}"
                                     SelectionChanged="OnIdePluginSelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding PluginName}"
                                                       AutomationProperties.Name="{Binding PluginPrefix, StringFormat={}{0}.Entry}"
                                                       Margin="6,0,0,0"
                                                       VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Content="↑"
                                                        AutomationProperties.Name="{Binding PluginPrefix, StringFormat={}{0}.MoveUp}"
                                                        Margin="12,0,0,0"
                                                        Padding="6,0"
                                                        Command="{Binding DataContext.IdePluginMoveUpCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                        CommandParameter="{Binding}" />
                                                <Button Content="↓"
                                                        AutomationProperties.Name="{Binding PluginPrefix, StringFormat={}{0}.MoveDown}"
                                                        Margin="4,0,0,0"
                                                        Padding="6,0"
                                                        Command="{Binding DataContext.IdePluginMoveDownCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                        CommandParameter="{Binding}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Rechte Spalte: Settings des im Aktivierungsregister ausgewählten Plugins -->
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <controls:PluginDetailPanel
                                Visibility="{Binding IsScmAiPluginContentVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                HeaderText="{Binding SelectedPlugin.PluginName}"
                                IsEnabledChecked="{Binding SelectedPlugin.IsEnabled, Mode=TwoWay}"
                                SettingsSource="{Binding SelectedPluginSettings}"
                                SettingsItemTemplate="{StaticResource PluginSettingGroupsItemTemplate}"
                                CheckboxAutomationName="PluginEnabled" />

                            <controls:PluginDetailPanel
                                Visibility="{Binding IsIdePluginContentVisible, Converter={StaticResource BoolToVisibilityConverter}}"
                                HeaderText="{Binding SelectedIdePlugin.PluginName}"
                                IsEnabledChecked="{Binding SelectedIdePlugin.IsEnabled, Mode=TwoWay}"
                                SettingsSource="{Binding SelectedIdePluginSettings}"
                                SettingsItemTemplate="{StaticResource PluginSettingGroupsItemTemplate}"
                                CheckboxAutomationName="IdePluginEnabled" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" Margin="0">
                        <TextBlock Margin="0,0,8,0" Foreground="{DynamicResource SecondaryTextBrush}" Opacity="0.88">⌘</TextBlock>
                        <TextBlock Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}">Promptvorlagen</TextBlock>
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" MaxWidth="900" HorizontalAlignment="Left">
                        <Button Content="Hinzufügen"
                                AutomationProperties.Name="AddPromptTemplate"
                                Command="{Binding AddPromptTemplateCommand}"
                                Padding="12,6"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,12" />

                        <ItemsControl ItemsSource="{Binding PromptTemplates}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12"
                                            Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="480" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Name"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,0,4" />
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="PromptTemplateName"
                                                         Padding="8,6" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Prompttext"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,0,4" />
                                                <TextBox Text="{Binding PromptText, UpdateSourceTrigger=PropertyChanged}"
                                                         AutomationProperties.Name="PromptTemplatePromptText"
                                                         Padding="8,6"
                                                         MinHeight="72"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto" />
                                            </StackPanel>
                                            <Button Grid.Column="3"
                                                    Content="Löschen"
                                                    AutomationProperties.Name="DeletePromptTemplate"
                                                    Command="{Binding DataContext.DeletePromptTemplateCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="12,6"
                                                    Margin="12,20,0,0"
                                                    VerticalAlignment="Top" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
