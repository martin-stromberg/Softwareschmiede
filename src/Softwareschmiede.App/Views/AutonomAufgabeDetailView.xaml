<UserControl x:Class="Softwareschmiede.App.Views.AutonomAufgabeDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource ErrorBrush}"
                Padding="10,7"
                Margin="0,0,0,12"
                Visibility="{Binding ErrorMessage, Converter={StaticResource NullOrEmptyToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}"
                       AutomationProperties.Name="AutonomAufgabeDetailFehler"
                       Foreground="White"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Start/Stop/Resume werden ausschließlich über das Ribbon (Gruppe "Autonome Aufgabe") gesteuert,
             siehe TaskDetailView.xaml — keine doppelte Bedienung im Inhaltsbereich. -->
        <TabControl Grid.Row="1" AutomationProperties.Name="AutonomAufgabeDetailTabs">
            <TabItem Header="Konfiguration">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Projektbranch" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Konfiguration.ProjektBranchName}" Margin="0,0,0,8" />
                        <TextBlock Text="Token-Budget" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Konfiguration.TokenBudget}" Margin="0,0,0,8" />
                        <TextBlock Text="Laufzeitlimit (Minuten)" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Konfiguration.LaufzeitLimitMinuten}" Margin="0,0,0,8" />
                        <TextBlock Text="Persistenz-Modus" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Konfiguration.PersistenzModus}" Margin="0,0,0,8" />
                        <TextBlock Text="Arbeitsverzeichnis" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Konfiguration.ArbeitsverzeichnisPfad}" TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Plan">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBox Grid.Row="0"
                             AutomationProperties.Name="AutonomAufgabePlanContent"
                             Text="{Binding PlanContent, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             Padding="8" />
                    <Button Grid.Row="1"
                            Content="Plan speichern"
                            AutomationProperties.Name="AutonomAufgabePlanSpeichern"
                            Command="{Binding SavePlanCommand}"
                            HorizontalAlignment="Right"
                            Padding="12,6"
                            Margin="0,8,0,0" />
                </Grid>
            </TabItem>

            <TabItem Header="Fortschritt">
                <TextBox AutomationProperties.Name="AutonomAufgabeProgressContent"
                         Text="{Binding ProgressContent}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8" />
            </TabItem>

            <TabItem Header="Governance">
                <TextBox AutomationProperties.Name="AutonomAufgabeGovernanceContent"
                         Text="{Binding GovernanceContent}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Padding="8" />
            </TabItem>

            <TabItem Header="Skills">
                <ListBox AutomationProperties.Name="AutonomAufgabeSkillsListe"
                         ItemsSource="{Binding Skills}"
                         DisplayMemberPath="Name" />
            </TabItem>

            <TabItem Header="Unteragenten">
                <DataGrid AutomationProperties.Name="AutonomAufgabeUnteragentenGrid"
                          ItemsSource="{Binding Unteragenten}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Agent-ID" Binding="{Binding ExterneAgentId}" />
                        <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" />
                        <DataGridTextColumn Header="Erzeugt" Binding="{Binding ErzeugungsDatum}" />
                        <DataGridTextColumn Header="Abgeschlossen" Binding="{Binding AbschlussDatum}" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
