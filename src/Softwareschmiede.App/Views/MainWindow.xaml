<Window x:Class="Softwareschmiede.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Softwareschmiede.App.Views"
        xmlns:vm="clr-namespace:Softwareschmiede.App.ViewModels"
        xmlns:controls="clr-namespace:Softwareschmiede.App.Controls"
        Title="{Binding Title}"
        Icon="/images/Softwareschmiede.ico"
        Width="1280" Height="800"
        MinWidth="900" MinHeight="600"
        Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectListViewModel}">
            <views:ProjectListView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectDetailViewModel}">
            <views:ProjectDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TaskDetailViewModel}">
            <views:TaskDetailView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScmEventQueueViewModel}">
            <views:ScmEventQueueView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Seitenleiste -->
        <Border Grid.Column="0"
                Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Width="{Binding IsNavigationExpanded, Converter={StaticResource BoolToWidthConverter}}"
                MinWidth="48">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <!-- Toggle Navigation -->
                    <Button Content="☰"
                            Command="{Binding ToggleNavigationCommand}"
                            Margin="8,8,8,16"
                            Padding="8,4"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Left"
                            FontSize="16" />

                    <!-- Navigation Items -->
                    <Button Command="{Binding NavigateToDashboardCommand}"
                            AutomationProperties.Name="Dashboard"
                            Margin="4,2"
                            Padding="8,8"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text=" Dashboard" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToProjectListCommand}"
                            AutomationProperties.Name=" Projekte"
                            Margin="4,2"
                            Padding="8,8"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📁" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text=" Projekte" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToScmEventQueueCommand}"
                            AutomationProperties.AutomationId="ScmEventQueueNavigation"
                            AutomationProperties.Name="SCM-Ereignisse"
                            ToolTip="{Binding ScmEventQueueLabel}"
                            Margin="4,2" Padding="8,8" Background="Transparent" BorderThickness="0"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇥" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ScmEventQueueLabel}" Margin="4,0,0,0"
                                       Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding NavigateToSettingsCommand}"
                            AutomationProperties.Name=" Einstellungen"
                            Margin="4,2"
                            Padding="8,8"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text=" Einstellungen" Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolToVisibilityConverter}}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Separator -->
                    <Border Height="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="8,8" />

                    <!-- Sektion: Aktive Aufgaben (Titel und Modus-Umschalter in getrennten Zeilen,
                         damit sich beide bei 240 px Seitenleistenbreite nicht überlappen) -->
                    <StackPanel Visibility="{Binding IsDashboardVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="Aktive Aufgaben"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="8,8,8,2" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="8,0,8,4"
                                    Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                            <RadioButton GroupName="WorkItemMode"
                                         Content="Datum"
                                         IsChecked="{Binding WorkItemListMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Date}"
                                         AutomationProperties.Name="WorkItemsMode:Date"
                                         ToolTip="Flache Liste, sortiert nach letzter Ausführung"
                                         FontSize="11"
                                         Margin="0,0,8,0" />
                            <RadioButton GroupName="WorkItemMode"
                                         Content="Repository"
                                         IsChecked="{Binding WorkItemListMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Repository}"
                                         AutomationProperties.Name="WorkItemsMode:Repository"
                                         ToolTip="Gruppiert nach Repository-Name"
                                         FontSize="11"
                                         Margin="0,0,8,0" />
                            <RadioButton GroupName="WorkItemMode"
                                         Content="KI"
                                         IsChecked="{Binding WorkItemListMode, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Ai}"
                                         AutomationProperties.Name="WorkItemsMode:AI"
                                         ToolTip="Gruppiert nach aktiver bzw. zuletzt verwendeter KI"
                                         FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Visibility="{Binding IsDashboardVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <controls:ActiveTasksListControl ItemsSource="{Binding ActiveWorkItemsList}"
                                                      NavigateCommand="{Binding NavigateToWorkItemCommand}"
                                                      ListMode="{Binding WorkItemListMode}"
                                                      AutomationProperties.AutomationId="ActiveWorkItemsListMenu" />
                </ScrollViewer>

                <StackPanel Grid.Row="2"
                            Margin="4,8,4,8">
                    <Border Height="1"
                            Background="{DynamicResource BorderBrush}"
                            Margin="4,0,4,8" />

                    <!-- Sektion: Auto-Shutdown bei Abschluss aller laufenden Automatisierungen -->
                    <StackPanel Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding RunningAutomationsCount, StringFormat={}{0} laufende Automatisierung(en)}"
                                   AutomationProperties.AutomationId="AutoShutdownRunningCount"
                                   FontSize="11"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="8,0,8,4" />
                        <CheckBox IsChecked="{Binding AutoShutdownEnabled}"
                                  Content="Nach Leerlauf PC herunterfahren"
                                  ToolTip="Fährt den Computer herunter, sobald keine Aufgabe mehr läuft und die Wartezeit abgelaufen ist. Andere Programme werden ebenfalls beendet."
                                  AutomationProperties.AutomationId="ActivateAutoShutdown"
                                  AutomationProperties.Name="Auto-Shutdown"
                                  FontSize="11"
                                  Margin="8,0,8,2"
                                  Visibility="{Binding AutoShutdownUiVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="8,0,8,2"
                                    ToolTip="So lange wird nach dem Ende der letzten laufenden Aufgabe noch gewartet, bevor der Computer herunterfährt."
                                    Visibility="{Binding AutoShutdownOptionsVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Wartezeit (Minuten):"
                                       FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                            <TextBox Text="{Binding AutoShutdownToleranceMinutes, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="AutoShutdownToleranceMinutes"
                                     AutomationProperties.Name="Auto-Shutdown-Wartezeit in Minuten"
                                     FontSize="11"
                                     Width="48"
                                     Margin="4,0,0,0"
                                     Padding="2,1" />
                        </StackPanel>
                        <CheckBox IsChecked="{Binding ForceAutoShutdown}"
                                  Content="Herunterfahren erzwingen"
                                  ToolTip="Erzwingt das Herunterfahren auch dann, wenn andere Programme das Beenden verweigern — nicht gespeicherte Daten gehen dabei verloren."
                                  AutomationProperties.AutomationId="ForceAutoShutdown"
                                  AutomationProperties.Name="Herunterfahren erzwingen"
                                  FontSize="11"
                                  Margin="8,0,8,2"
                                  Visibility="{Binding AutoShutdownOptionsVisible, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding AutoShutdownCountdownText}"
                                   AutomationProperties.AutomationId="AutoShutdownCountdown"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="8,0,8,2"
                                   Visibility="{Binding AutoShutdownCountdownActive, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Text="{Binding AutoShutdownToleranceError}"
                                   AutomationProperties.AutomationId="AutoShutdownToleranceError"
                                   FontSize="11"
                                   Foreground="{DynamicResource ErrorBrush}"
                                   TextWrapping="Wrap"
                                   Margin="8,0,8,2"
                                   Visibility="{Binding AutoShutdownToleranceError, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding CurrentVersion}"
                               AutomationProperties.AutomationId="AppVersionText"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="8,0,8,8"
                               Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <Button Command="{Binding StartUpdateCommand}"
                            Visibility="{Binding UpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                            AutomationProperties.Name="Programmupdate starten"
                            ToolTip="{Binding AvailableUpdate.Version, StringFormat=Update auf Version {0} vorbereiten}"
                            Margin="0,2"
                            Padding="8,8"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⇧" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text=" Update"
                                       Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CheckUpdateCommand}"
                            AutomationProperties.Name="Programmupdate prüfen"
                            ToolTip="{Binding UpdateCheckTooltip}"
                            ToolTipService.ShowOnDisabled="True"
                            Margin="0,2"
                            Padding="8,8"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⟳" FontSize="16" VerticalAlignment="Center" />
                            <TextBlock Text=" Prüfen"
                                       Visibility="{Binding IsNavigationExpanded, Converter={StaticResource BoolToVisibilityConverter}}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Kein AutomationProperties.Name: Für E2E-Tests muss der gebundene Hinweistext
                         als UIA-Name lesbar bleiben; die Adressierung läuft über die AutomationId. -->
                    <TextBlock Text="{Binding UpdateNotice}"
                               AutomationProperties.AutomationId="UpdateNotice"
                               FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="8,4,8,0"
                               Visibility="{Binding UpdateNotice, Converter={StaticResource NullOrEmptyToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Inhaltsbereich -->
        <ContentControl Grid.Column="1"
                        Content="{Binding CurrentView}"
                        Margin="0" />
    </Grid>
</Window>
