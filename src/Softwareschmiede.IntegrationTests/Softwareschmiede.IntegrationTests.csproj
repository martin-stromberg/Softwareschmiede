<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
    <!-- VSTest-Modus erhalten (collect/filter/logger trx in CI);
         xunit.v3.mtp-v2 setzt sonst IsTestingPlatformApplication=true, was dotnet test
         unter .NET 10+ in den MTP-Pfad zwingt. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\Softwareschmiede.Tests\Helpers\ScmDispatchFixture.cs" Link="Infrastructure\ScmDispatchFixture.cs" />
    <Compile Include="..\Softwareschmiede.Tests\Helpers\ScmTestServices.cs" Link="Infrastructure\ScmTestServices.cs" />
    <Compile Include="..\Softwareschmiede.Tests\Helpers\TempDirectoryCleanup.cs" Link="Infrastructure\TempDirectoryCleanup.cs" />
    <Compile Include="..\Softwareschmiede.Tests\Helpers\FakeGitHubEventApi.cs" Link="Helpers\FakeGitHubEventApi.cs" />
    <!-- FlakyConventionTests scannt jeweils die eigene Assembly — per Link auch hier
         eingebunden, damit die Regel "Flaky nur mit OsInterface" genau dort abgesichert
         ist, wo derzeit Flaky-markierte Tests liegen. TestCategories/FlakyAttribute/
         OsInterfaceAttribute sind die Compile-Abhaengigkeiten des Tests. -->
    <Compile Include="..\Softwareschmiede.Tests\Infrastructure\Testing\FlakyConventionTests.cs" Link="Infrastructure\FlakyConventionTests.cs" />
    <Compile Include="..\Softwareschmiede.Tests\Infrastructure\Testing\TestCategories.cs" Link="Infrastructure\TestCategories.cs" />
    <Compile Include="..\Softwareschmiede.Tests\Infrastructure\Testing\FlakyAttribute.cs" Link="Infrastructure\FlakyAttribute.cs" />
    <Compile Include="..\Softwareschmiede.Tests\Infrastructure\Testing\OsInterfaceAttribute.cs" Link="Infrastructure\OsInterfaceAttribute.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Softwareschmiede\Softwareschmiede.csproj" />
    <ProjectReference Include="..\..\plugins\Softwareschmiede.Plugin.GitHub\Softwareschmiede.Plugin.GitHub.csproj" />
    <ProjectReference Include="..\..\plugins\Softwareschmiede.Plugin.LocalDirectory\Softwareschmiede.Plugin.LocalDirectory.csproj" />
    <ProjectReference Include="..\..\plugins\Softwareschmiede.Plugin.Codex\Softwareschmiede.Plugin.Codex.csproj" />
    <ProjectReference Include="..\..\plugins\Softwareschmiede.Plugin.ClaudeCli\Softwareschmiede.Plugin.ClaudeCli.csproj" />
    <ProjectReference Include="..\..\plugins\Softwareschmiede.Plugin.Devin\Softwareschmiede.Plugin.Devin.csproj" />
  </ItemGroup>

</Project>
