[18:41:24 INF] Executed DbCommand (0ms) [Parameters=[@afterSequence='?' (DbType = Int64), @upperSequence='?' (DbType = Int64), @nowMilliseconds='?' (DbType = Int64), @p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
