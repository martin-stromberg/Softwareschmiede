[18:40:11 INF] Executed DbCommand (0ms) [Parameters=[@p0='?' (DbType = Guid), @p1='?' (Size = 32), @p2='?' (DbType = Int64), @p3='?' (Size = 32), @p4='?' (DbType = Int64), @p5='?' (DbType = Int64), @p6='?' (Size = 32)], CommandType='Text', CommandTimeout='30']&#xD;
