[18:40:38 INF] Executed DbCommand (0ms) [Parameters=[@p0='?' (DbType = Guid), @p1='?' (Size = 32), @p2='?' (DbType = Int64), @p3='?' (Size = 32), @p4='?' (DbType = Int64), @p5='?' (DbType = Int64), @p6='?' (Size = 32)], CommandType='Text', CommandTimeout='30']&#xD;
INSERT INTO ScmTaskLeases (AufgabeId, Owner, ExpiresUtc) VALUES (@p0, @p1, @p2) ON CONFLICT(AufgabeId) DO UPDATE SET Owner = @p3, ExpiresUtc = @p4 WHERE ExpiresUtc &lt; @p5 OR Owner = @p6&#xD;
