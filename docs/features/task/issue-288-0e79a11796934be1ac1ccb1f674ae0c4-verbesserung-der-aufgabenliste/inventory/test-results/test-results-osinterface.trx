[18:41:21 INF] Executed DbCommand (0ms) [Parameters=[@afterSequence='?' (DbType = Int64), @upperSequence='?' (DbType = Int64), @nowMilliseconds='?' (DbType = Int64), @p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
SELECT "s"."Id", "s"."Sequence"&#xD;
