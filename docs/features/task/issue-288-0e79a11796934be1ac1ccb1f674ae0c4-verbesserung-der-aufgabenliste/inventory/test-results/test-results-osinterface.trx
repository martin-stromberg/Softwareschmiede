[18:40:17 INF] Executed DbCommand (0ms) [Parameters=[@p0='?' (DbType = Guid), @p1='?' (Size = 32), @p2='?' (DbType = Int64), @p3='?' (Size = 32), @p4='?' (DbType = Int64), @p5='?' (DbType = Int64), @p6='?' (Size = 32)], CommandType='Text', CommandTimeout='30']&#xD;
INSERT INTO ScmTaskLeases (AufgabeId, Owner, ExpiresUtc) VALUES (@p0, @p1, @p2) ON CONFLICT(AufgabeId) DO UPDATE SET Owner = @p3, ExpiresUtc = @p4 WHERE ExpiresUtc &lt; @p5 OR Owner = @p6&#xD;
[18:40:17 INF] Executed DbCommand (0ms) [Parameters=[@eventId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
SELECT "s"."Sequence", "s"."AcceptedUtc", "s"."Attempts", "s"."AufgabeId", "s"."CliRunId", "s"."DeliveredUtc", "s"."DeliveryAttemptId", "s"."ErrorCode", "s"."EventKey", "s"."ExchangePath", "s"."ExchangeRestrictedWriteSidsJson", "s"."Id", "s"."LeaseOwner", "s"."LeaseUntilUtc", "s"."NextAttemptUtc", "s"."ObservationJson", "s"."ReadyConfirmedRunId", "s"."Reason", "s"."ReceivedUtc", "s"."Status"&#xD;
FROM "ScmIncomingEvents" AS "s"&#xD;
