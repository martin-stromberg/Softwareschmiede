[18:40:28 INF] Executed DbCommand (0ms) [Parameters=[@afterSequence='?' (DbType = Int64), @upperSequence='?' (DbType = Int64), @nowMilliseconds='?' (DbType = Int64), @p='?' (DbType = Int32)], CommandType='Text', CommandTimeout='30']&#xD;
SELECT "s"."Id", "s"."Sequence"&#xD;
FROM "ScmIncomingEvents" AS "s"&#xD;
WHERE "s"."Sequence" &gt; @afterSequence AND "s"."Sequence" &lt;= @upperSequence AND "s"."Status" &lt;&gt; 'Abgebrochen' AND (("s"."Status" &lt;&gt; 'Verarbeitet' AND ("s"."NextAttemptUtc" IS NULL OR "s"."NextAttemptUtc" &lt;= @nowMilliseconds)) OR EXISTS (&#xD;
    SELECT 1&#xD;
    FROM "ScmOutgoingActions" AS "s0"&#xD;
    WHERE "s0"."EventId" = "s"."Id" AND "s0"."Status" &lt;&gt; 'Succeeded' AND ("s0"."NextAttemptUtc" IS NULL OR "s0"."NextAttemptUtc" &lt;= @nowMilliseconds)))&#xD;
ORDER BY "s"."Sequence"&#xD;
LIMIT @p&#xD;
