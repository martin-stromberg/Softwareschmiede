    SELECT 1&#xD;
    FROM "ScmIncomingEvents" AS "s"&#xD;
    WHERE "s"."AufgabeId" = @item_AufgabeId AND "s"."Sequence" &lt; @item_Sequence AND "s"."Status" &lt;&gt; 'Verarbeitet' AND "s"."Status" &lt;&gt; 'Abgebrochen')&#xD;
[18:40:38 INF] Executed DbCommand (0ms) [Parameters=[@item_AufgabeId='?' (DbType = Guid)], CommandType='Text', CommandTimeout='30']&#xD;
SELECT "a"."Id", "a"."AbschlussDatum", "a"."AgentenName", "a"."AgentenpaketName", "a"."AktiveRunId", "a"."AnforderungsBeschreibung", "a"."AusfuehrungsStatus", "a"."BasisBranchName", "a"."BranchName", "a"."ErstellungsDatum", "a"."GitRepositoryId", "a"."KiPluginPrefix", "a"."LastHeartbeatUtc", "a"."LaufStatus", "a"."LetzterCliStartUtc", "a"."LokalerKlonPfad", "a"."PausiertBisUtc", "a"."ProjektId", "a"."RecoveryVersion", "a"."Status", "a"."Titel", "a"."VorschlagAusfuehrenAbUtc", "a"."VorschlagPrompt", "g"."Id", "g"."Aktiv", "g"."DefaultSourceBranchName", "g"."PluginTyp", "g"."ProjektId", "g"."RepositoryName", "g"."RepositoryUrl"&#xD;
FROM "Aufgaben" AS "a"&#xD;
LEFT JOIN "GitRepositories" AS "g" ON "a"."GitRepositoryId" = "g"."Id"&#xD;
