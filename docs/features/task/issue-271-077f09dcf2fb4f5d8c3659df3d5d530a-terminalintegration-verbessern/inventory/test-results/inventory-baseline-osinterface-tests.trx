SELECT "a0"."Id", "a0"."AbschlussDatum", "a0"."AgentenName", "a0"."AgentenpaketName", "a0"."AktiveRunId", "a0"."AnforderungsBeschreibung", "a0"."AusfuehrungsStatus", "a0"."BasisBranchName", "a0"."BranchName", "a0"."ErstellungsDatum", "a0"."GitRepositoryId", "a0"."KiPluginPrefix", "a0"."LastHeartbeatUtc", "a0"."LaufStatus", "a0"."LetzterCliStartUtc", "a0"."LokalerKlonPfad", "a0"."PausiertBisUtc", "a0"."ProjektId", "a0"."RecoveryVersion", "a0"."Status", "a0"."Titel", "a0"."VorschlagAusfuehrenAbUtc", "a0"."VorschlagPrompt", "p"."Id", "p"."Beschreibung", "p"."ErstellungsDatum", "p"."Name", "p"."Status", "g"."Id", "g"."Aktiv", "g"."DefaultSourceBranchName", "g"."PluginTyp", "g"."ProjektId", "g"."RepositoryName", "g"."RepositoryUrl"&#xD;
FROM (&#xD;
    SELECT "a"."Id", "a"."AbschlussDatum", "a"."AgentenName", "a"."AgentenpaketName", "a"."AktiveRunId", "a"."AnforderungsBeschreibung", "a"."AusfuehrungsStatus", "a"."BasisBranchName", "a"."BranchName", "a"."ErstellungsDatum", "a"."GitRepositoryId", "a"."KiPluginPrefix", "a"."LastHeartbeatUtc", "a"."LaufStatus", "a"."LetzterCliStartUtc", "a"."LokalerKlonPfad", "a"."PausiertBisUtc", "a"."ProjektId", "a"."RecoveryVersion", "a"."Status", "a"."Titel", "a"."VorschlagAusfuehrenAbUtc", "a"."VorschlagPrompt", COALESCE("a"."LetzterCliStartUtc", "a"."ErstellungsDatum") AS "c"&#xD;
    FROM "Aufgaben" AS "a"&#xD;
    WHERE "a"."Status" IN ('Gestartet', 'Wartend')&#xD;
    ORDER BY COALESCE("a"."LetzterCliStartUtc", "a"."ErstellungsDatum") DESC, "a"."Titel", "a"."Id"&#xD;
    LIMIT @p&#xD;
) AS "a0"&#xD;
INNER JOIN "Projekte" AS "p" ON "a0"."ProjektId" = "p"."Id"&#xD;
LEFT JOIN "GitRepositories" AS "g" ON "a0"."GitRepositoryId" = "g"."Id"&#xD;
ORDER BY "a0"."c" DESC, "a0"."Titel", "a0"."Id"&#xD;
