[23:45:54 INF] Applying migration '20260816193940_AddAufgabeAusfuehrungsStatus'.&#xD;
[23:45:54 INF] Executed DbCommand (0ms) [Parameters=[], CommandType='Text', CommandTimeout='30']&#xD;
ALTER TABLE "Aufgaben" ADD "AusfuehrungsStatus" TEXT NOT NULL DEFAULT 'NichtGestartet';&#xD;
[23:45:54 INF] Executed DbCommand (0ms) [Parameters=[], CommandType='Text', CommandTimeout='30']&#xD;
UPDATE Aufgaben&#xD;
SET AusfuehrungsStatus = CASE&#xD;
    WHEN Status = 'Neu' THEN 'NichtGestartet'&#xD;
    WHEN Status IN ('Gestartet', 'Wartend')&#xD;
        AND AktiveRunId IS NOT NULL&#xD;
        AND length(trim(AktiveRunId)) &gt; 0 THEN 'Aktiv'&#xD;
    WHEN Status IN ('Gestartet', 'Wartend') THEN 'Beendet'&#xD;
    WHEN Status IN ('Beendet', 'Archiviert') THEN 'Beendet'&#xD;
    ELSE 'NichtGestartet'&#xD;
END&#xD;
[23:45:54 INF] Executed DbCommand (0ms) [Parameters=[], CommandType='Text', CommandTimeout='30']&#xD;
