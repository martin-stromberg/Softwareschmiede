[12:42:08 INF] Executed DbCommand (0ms) [Parameters=[@cutoff='?' (DbType = Int64), @now='?' (DbType = Int64)], CommandType='Text', CommandTimeout='30']&#xD;
SELECT "a"."Id"&#xD;
