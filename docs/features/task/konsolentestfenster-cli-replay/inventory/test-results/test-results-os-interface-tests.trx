LEFT JOIN "AutonomAufgabeKonfigurationen" AS "a0" ON "a"."Id" = "a0"."AufgabeId"&#xD;
WHERE "a"."Status" IN ('Gestartet', 'Wartend') AND "a"."AusfuehrungsStatus" = 'Aktiv' AND "a"."LastHeartbeatUtc" IS NOT NULL AND "a"."LastHeartbeatUtc" &lt; @cutoff AND ("a"."PausiertBisUtc" IS NULL OR "a"."PausiertBisUtc" &lt;= @now) AND "a0"."Id" IS NULL&#xD;
