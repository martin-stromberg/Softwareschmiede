    SELECT "p"."Id", "p"."AufgabeId", "p"."CreatedUtc", "p"."HeadSha", "p"."LastCheckedUtc", "p"."LastError", "p"."MergeCommitSha", "p"."MergeStatus", "p"."MonitoringPhase", "p"."NextCheckUtc", "p"."Provider", "p"."ProviderPullRequestId", "p"."PullRequestNumber", "p"."RepositoryId", "p"."Rolle", "p"."SourceBranch", "p"."SourceRef", "p"."SourceRepositoryId", "p"."SourceRepositoryUrl", "p"."Status", "p"."TargetBranch", "p"."Titel", "p"."Url", COALESCE("p"."LastCheckedUtc", -62135596800000) AS "c"&#xD;
    FROM "PullRequestReferenzen" AS "p"&#xD;
    WHERE "p"."MonitoringPhase" NOT IN ('PostMergeSucceeded', 'PostMergeFailed', 'Completed', 'Failed', 'NotMonitored') AND "p"."Provider" = 'GitHub' AND ("p"."NextCheckUtc" IS NULL OR "p"."NextCheckUtc" &lt;= @now)&#xD;
    ORDER BY COALESCE("p"."LastCheckedUtc", -62135596800000)&#xD;
    LIMIT @p&#xD;
) AS "p1"&#xD;
LEFT JOIN "PullRequestWorkflowRuns" AS "p0" ON "p1"."Id" = "p0"."PullRequestReferenzId"&#xD;
ORDER BY "p1"."c", "p1"."Id"&#xD;
