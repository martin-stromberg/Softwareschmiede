    SELECT "a"."Id", "a"."AbschlussDatum", "a"."AgentenName", "a"."AgentenpaketName", "a"."AktiveRunId", "a"."AnforderungsBeschreibung", "a"."AusfuehrungsStatus", "a"."BasisBranchName", "a"."BranchName", "a"."ErstellungsDatum", "a"."GitRepositoryId", "a"."KiPluginPrefix", "a"."LastHeartbeatUtc", "a"."LaufStatus", "a"."LetzterCliStartUtc", "a"."LokalerKlonPfad", "a"."ProjektId", "a"."RecoveryVersion", "a"."Status", "a"."Titel", "a"."VorschlagAusfuehrenAbUtc", "a"."VorschlagPrompt", COALESCE("a"."LetzterCliStartUtc", "a"."ErstellungsDatum") AS "c"&#xD;
