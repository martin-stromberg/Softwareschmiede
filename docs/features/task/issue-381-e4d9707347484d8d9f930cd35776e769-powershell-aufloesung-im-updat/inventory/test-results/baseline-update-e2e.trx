FROM (&#xD;
    SELECT "a"."Id", "a"."AbschlussDatum", "a"."AgentenName", "a"."AgentenpaketName", "a"."AktiveRunId", "a"."AnforderungsBeschreibung", "a"."AusfuehrungsStatus", "a"."BasisBranchName", "a"."BranchName", "a"."ErstellungsDatum", "a"."GitRepositoryId", "a"."KiPluginPrefix", "a"."LastHeartbeatUtc", "a"."LaufStatus", "a"."LetzterCliStartUtc", "a"."LokalerKlonPfad", "a"."PausiertBisUtc", "a"."ProjektId", "a"."RecoveryVersion", "a"."ScmAbschlussErkanntUtc", "a"."ScmAbschlussReferenz", "a"."Status", "a"."Titel", "a"."VorschlagAusfuehrenAbUtc", "a"."VorschlagPrompt", COALESCE("a"."LetzterCliStartUtc", "a"."ErstellungsDatum") AS "c"&#xD;
    FROM "Aufgaben" AS "a"&#xD;
    WHERE "a"."Status" IN ('Gestartet', 'Wartend')&#xD;
    ORDER BY COALESCE("a"."LetzterCliStartUtc", "a"."ErstellungsDatum") DESC, "a"."Titel", "a"."Id"&#xD;
    LIMIT @p&#xD;
) AS "a0"&#xD;
INNER JOIN "Projekte" AS "p" ON "a0"."ProjektId" = "p"."Id"&#xD;
LEFT JOIN "GitRepositories" AS "g" ON "a0"."GitRepositoryId" = "g"."Id"&#xD;
ORDER BY "a0"."c" DESC, "a0"."Titel", "a0"."Id"&#xD;
