#!/usr/bin/env sh
# Spiegelt den "Lint and format check"-Schritt aus .github/workflows/pr.yml lokal,
# damit ein Formatierungsfehler vor dem Push auffaellt statt erst in der PR-CI.
# Aktivierung (einmalig pro Klon): git config core.hooksPath .githooks

set -e

echo "pre-push: dotnet format Lint-Check laeuft (wie in .github/workflows/pr.yml)..."

dotnet restore Softwareschmiede.slnx
dotnet format Softwareschmiede.slnx --verify-no-changes --no-restore

echo "pre-push: Lint-Check bestanden."
